# ---------------------------------------------------------------------------
# SOURDEN — ignore rules
# Never commit secrets. All runtime configuration lives in environment
# variables (see .env.example) and is injected by Cloudflare at build time.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Astro / Vite build output
dist/
.astro/
.output/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.env
.env.*
!.env.example

# Local secrets & credentials
*.pem
*.key
secrets.json
.dev.vars.*
!.dev.vars.example

# Editor / OS noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Logs / caches
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.cache/

# Build-time responsive-image manifest (regenerated by scripts/gen-srcset.mjs
# on every prebuild; never commit — Cloudflare regenerates it from the sources)
.srcset-manifest.json

# Responsive @w variants are regenerated at build time (locally by prebuild,
# in the cloud by the Cloudflare build) — never upload/commit them.
public/images/*@*.webp

# Generated placeholder art is committed on purpose (it is the V1 visual
# baseline). Un-comment the next line only if you switch to build-time
# generation. See IMAGES.md.
# public/images/

# Collection source material (incoming/) — raw owner uploads + the filled-in
# collection.md are a local workspace for scripts/add-collection.mjs; the
# script emits the real page into src/data/ and public/images/. Only the
# template and the instructions are committed.
incoming/*
!incoming/_TEMPLATE/
!incoming/README.md
