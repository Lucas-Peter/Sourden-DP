# ---------------------------------------------------------------------------
# SOURDEN — environment variable template
# Copy to `.env` for local development. `.env` is git-ignored.
#
# On Cloudflare Pages, these are set in:
#   Pages project → Settings → Environment variables
# Encrypt anything sensitive (there is nothing sensitive in V1).
# ---------------------------------------------------------------------------

# Canonical production origin, no trailing slash.
# Used for <link rel="canonical">, Open Graph URLs and sitemap.xml.
PUBLIC_SITE_URL=https://sourden.com

# Public contact address rendered in the footer.
PUBLIC_CONTACT_EMAIL=hello@sourden.com

# ---------------------------------------------------------------------------
# RESERVED — not used in V1. Do not enable until the matching Cloudflare
# resource exists (spec §36).
# ---------------------------------------------------------------------------

# Cloudflare Turnstile — public site key (safe to expose to the browser).
# PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile — secret key.
# SERVER ONLY. Never prefix with PUBLIC_.
# TURNSTILE_SECRET_KEY=

# D1 binding names are declared in wrangler.toml, not here.
# R2 bucket name:
# R2_UPLOAD_BUCKET=

# Outbound notification email (inquiry forwarding). SERVER ONLY.
# INQUIRY_NOTIFY_TO=
