# ---------------------------------------------------------------------------
# SOURDEN — environment variable template
# Copy to `.env` for local development. `.env` is git-ignored.
#
# On Cloudflare, these are BUILD-time values (Astro inlines `import.meta.env`
# into the HTML during `npm run build`). Set them in:
#   Cloudflare dashboard → the Worker project → Settings → Build
#   → Variables and secrets
#
# They must be defined for BOTH production and non-production builds, and they
# must exist BEFORE the first production build — otherwise the canonical URLs
# in <head> and sitemap.xml fall back to the placeholder domain in
# src/data/site.js.
#
# This is NOT the same place as the Worker's runtime variables: Cloudflare
# keeps build-time and runtime variables separate, and nothing in V1 reads a
# runtime variable at all.
# Encrypt anything sensitive (there is nothing sensitive in V1).
# ---------------------------------------------------------------------------

# Canonical production origin, no trailing slash.
# Used for <link rel="canonical">, Open Graph URLs and sitemap.xml.
PUBLIC_SITE_URL=https://sourden.com

# Public contact address rendered in the footer.
PUBLIC_CONTACT_EMAIL=service@sourden.com

# Cloudflare Turnstile — PUBLIC site key (this value is designed to be visible
# in the page, so the PUBLIC_ prefix is correct here).
#
# Leave it EMPTY and the sourcing-request form renders no widget, loads no
# third-party script and makes no request to Cloudflare — which is the correct
# behaviour for local development. Set it, and the widget appears with no other
# change to the form (src/components/TurnstileWidget.astro).
#
# The matching SECRET key is server-side only and is deliberately absent from
# this file — see the RESERVED block below.
PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# WORKER RUNTIME SECRETS — NOT build-time, so NOT set here.
# ---------------------------------------------------------------------------
# V1 introduced a Worker (worker/index.js) that reads RUNTIME variables from
# `env`. Those belong in .dev.vars.example (for local `wrangler dev`) and as
# encrypted Secrets in the Cloudflare dashboard for production — never in this
# build-time .env file. See .dev.vars.example for the full list:
#
#   RESEND_API_KEY       — Resend API key (sends notification + confirmation)
#   TURNSTILE_SECRET_KEY — Turnstile secret (server-side token verification)
#
# The outbound notification address is a hard-coded constant in worker/index.js
# (service@sourden.com) per spec, so there is no INQUIRY_NOTIFY_TO variable.
# D1 / R2 are intentionally out of scope for V1 (no DB, no file uploads).
