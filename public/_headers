# ---------------------------------------------------------------------------
# SOURDEN — Cloudflare Pages response headers
# ---------------------------------------------------------------------------
# Cloudflare Pages reads this file automatically at deploy time. Syntax:
#   <url-pattern>
#     <Header-Name>: <value>
# The most specific matching pattern wins.
# Reference: https://developers.cloudflare.com/pages/configuration/headers/
# ---------------------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed build assets are content-addressed, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts shipped by Fontsource are fingerprinted by Astro into /_astro, but the
# rule below also covers any font placed in /public/fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Placeholder artwork. Lower TTL than build assets so a replaced photograph
# propagates quickly.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap*.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# ---------------------------------------------------------------------------
# CONTENT SECURITY POLICY — intentionally not enabled yet.
#
# Astro emits a small inline script in <head> (the progressive-enhancement
# `js-reveal` flag) plus a bundled module for the mobile menu. A strict CSP
# must therefore allow those specific hashes/nonces, otherwise the menu breaks.
#
# When the site goes live, verify the real script hashes in the browser console
# and then add a policy along these lines:
#
# /*
#   Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-<hash>'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
# ---------------------------------------------------------------------------
