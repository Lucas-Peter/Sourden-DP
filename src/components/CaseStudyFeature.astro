---
/**
 * CaseStudyFeature — the featured entry of the homepage Case Studies section.
 * Editorial layout (one large card), NOT a link: the homepage section is the
 * whole feature — there are no /case-studies detail pages (2026-10-02).
 *
 * Honest-content discipline: these entries are sourcing scenarios, never
 * dressed up as customer projects (spec §39, §43).
 */
import Media from './Media.astro';

interface Study {
  number: string;
  title: string;
  summary: string;
  images: Array<{ key: string; caption: string | null }>;
  scope: string[];
}

interface Props {
  study: Study;
}

const { study } = Astro.props;

const imageKey = study.images[0]?.key;
---

<article class="case-feature">
    {imageKey && <Media imageKey={imageKey} ratio="4x3" zoom />}

    <div class="case-feature__body">
      <span class="num">{study.number}</span>
      <h3 class="case-feature__title">{study.title}</h3>

      {
        study.scope.length > 0 && (
          <span class="case-feature__scope">
            {study.scope.map((tag) => (
              <span>{tag}</span>
            ))}
          </span>
        )
      }

      <p class="case-feature__summary">{study.summary}</p>
    </div>
</article>
