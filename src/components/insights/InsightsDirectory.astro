---
/**
 * InsightsDirectory — §5's article directory, with paging
 * ---------------------------------------------------------------------------
 * One band: the section header, a count line, the grid of twelve cards, and a
 * paging control band that appears only once the library is longer than one
 * page.
 *
 * This band used to carry §4's category filter as well — seven chips above the
 * grid, plus a `?category=` state and a `role="status"` line announcing how many
 * insights matched. The filter is gone with the page's other removed bands (see
 * `insights-page.js` for the full list and for what it means for §4's
 * categories, which survive on the cards as tags).
 *
 * ── THE SERVER RENDERS EVERY CARD. THE SCRIPT ONLY DECIDES WHAT IS VISIBLE ──
 * All twelve cards are in the HTML, always. That is the crawler's view and the
 * no-JS view, and it is why paging here is an enhancement rather than a
 * dependency: if the script never runs, a visitor sees the whole library and a
 * count that says how many articles the library holds — both true statements,
 * neither one a degraded page.
 *
 * ── THE COUNT LINE IS THE ONE PLACE TWO RENDERERS WRITE THE SAME SENTENCE ───
 * The count is produced twice: here at build time for the state the page ships
 * in, and in the browser every time the visitor changes page. Both read the same
 * three templates out of `directory.paging` (the page's data file) — this
 * component does not carry a copy of the wording. The `{count}`, `{shown}` and
 * `{total}` tokens are the contract between the two; the substitution itself is
 * one line in each, which is cheaper than a shared module the client bundle
 * would have to pull the whole page's data through.
 *
 * ── `role="status"` ON THE COUNT, AND WHY NOTHING ELSE IS A LIVE REGION ─────
 * Paging is a visual-only change: a screen-reader user who activates "Next" gets
 * no feedback at all unless something announces it, and the count is exactly the
 * information that changed. So the count is a polite live region and every other
 * part of the update is silent.
 *
 * ── WHY THE CONTROL BAND IS `hidden` AND NOT ABSENT ────────────────────────
 * The `<nav>` is always in the DOM so the script has something to fill and so
 * there is no layout shift when paging appears; `hidden` is what removes it.
 * ⚠ `[hidden]` has exactly one declaration in the user-agent stylesheet —
 * `display: none` — and ANY author declaration of `display` on the same element
 * beats it, because author styles outrank UA styles. `.in-pagination` sets
 * `display: flex`, so without the `.in-pagination[hidden]` rule in `insights.css`
 * an empty bordered row would sit under every directory on the site. The failure
 * mode leaves the markup perfect and the script correct; only the geometry is
 * wrong. The gate asserts the computed display, not the attribute.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import InsightCard from './InsightCard.astro';
import { articleHref, categoryFor } from '../../data/insights-articles.js';

interface Props {
  directory: {
    eyebrow: string;
    title: string;
    description: string;
    readLabel: string;
    articles: Array<{
      slug: string;
      title: string;
      description: string;
      imageKey: string | null;
      categorySlug: string;
    }>;
    paging: {
      pageSize: number;
      navLabel: string;
      prev: string;
      next: string;
      gap: string;
      pageLabel: string;
      countMany: string;
      countOne: string;
      countPaged: string;
    };
  };
  tone: 'ivory' | 'white';
  titleId: string;
}

const { directory, tone, titleId } = Astro.props;
const { paging } = directory;

/* The state the page ships in. The library fits on one page today, so this is
   the "N articles" form; if it did not fit, the paged form would be rendered
   for page 1 and the script would agree with it on load.

   With scripting off this line is never corrected, and it stays true for the
   reason the header gives: the whole library is on the page. */
const total = directory.articles.length;
const initialCount =
  total === 1 ? paging.countOne : paging.countMany.replace('{count}', String(total));
---

<section class={`section section--${tone} in-directory`} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader
      id={titleId}
      eyebrow={directory.eyebrow}
      title={directory.title}
      lead={directory.description}
      class="in-directory__head"
    />

    {/* Every word the count can print, and the size of a page, handed to the
        script through the element it updates. The three templates are read back
        in the script below; none of them is retyped there. */}
    <p
      class="in-count"
      role="status"
      data-insight-count
      data-page-size={paging.pageSize}
      data-count-one={paging.countOne}
      data-count-many={paging.countMany}
      data-count-paged={paging.countPaged}
    >
      {initialCount}
    </p>

    <ul class="in-grid" data-insight-grid data-reveal-group>
      {
        directory.articles.map((article) => (
          <InsightCard
            article={article}
            category={categoryFor(article.categorySlug)}
            href={articleHref(article)}
            readLabel={directory.readLabel}
          />
        ))
      }
    </ul>

    <nav
      class="in-pagination"
      aria-label={paging.navLabel}
      data-insight-pagination
      data-label-prev={paging.prev}
      data-label-next={paging.next}
      data-label-gap={paging.gap}
      data-label-page={paging.pageLabel}
      hidden
    >
    </nav>
  </div>
</section>

<script>
  /* ---------------------------------------------------------------------------
     Paging — progressive enhancement over the server-rendered grid.

     None of the wording lives here: the count's three templates come off the
     count element and the control labels off the control band, both rendered
     from `insights-page.js`. This script only decides WHICH cards are on screen
     and WHICH control is current.
     ------------------------------------------------------------------------- */
  const grid = document.querySelector('[data-insight-grid]');
  const nav = document.querySelector('[data-insight-pagination]');
  const counter = document.querySelector('[data-insight-count]');

  if (grid && nav && counter) {
    const pageSize = Number(counter.dataset.pageSize);

    /* No page size means no paging — bail out rather than divide by zero and
       print "Page 1 of Infinity". The library then shows in full, which is the
       same state a visitor without scripting gets. */
    if (pageSize >= 1) {
      const templates = {
        one: counter.dataset.countOne || '',
        many: counter.dataset.countMany || '',
        paged: counter.dataset.countPaged || '',
      };
      const words = {
        prev: nav.dataset.labelPrev || '',
        next: nav.dataset.labelNext || '',
        gap: nav.dataset.labelGap || '',
        page: nav.dataset.labelPage || '',
      };

      const fill = (template, values) =>
        template.replace(/\{(\w+)\}/g, (match, key) =>
          key in values ? String(values[key]) : match
        );

      /* The directory's own address, read rather than typed. A relative `?page=2`
         would resolve against this URL correctly, but a relative drop back to
         page 1 would not: on `/insights` (no trailing slash) `./` resolves to
         `/`. So the path is taken from the location — which also means the
         control band has real, correct hrefs for a crawler and for a modified
         click. */
      const base = window.location.pathname;

      /* Re-read on every render rather than capturing a snapshot at load: the
         grid is the page's live content, and a snapshot would make the controls
         describe a directory that no longer exists the moment anything else
         touches it. */
      const cards = () => Array.from(grid.querySelectorAll('.in-card'));
      const lastPage = () => Math.max(1, Math.ceil(cards().length / pageSize));

      const pageFromLocation = () => {
        const raw = parseInt(
          new URLSearchParams(window.location.search).get('page'),
          10
        );
        if (isNaN(raw) || raw < 1) return 1;
        /* A stale `?page=9` on a three-page library lands on the last page
           rather than on an empty grid. */
        return Math.min(raw, lastPage());
      };

      const show = (page) => {
        const all = cards();
        const start = (page - 1) * pageSize;
        const end = start + pageSize;
        let shown = 0;

        all.forEach((card, index) => {
          const visible = index >= start && index < end;
          if (visible) card.removeAttribute('hidden');
          else card.setAttribute('hidden', '');
          if (visible) shown += 1;
        });

        counter.textContent =
          all.length <= pageSize
            ? all.length === 1
              ? templates.one
              : fill(templates.many, { count: all.length })
            : fill(templates.paged, { shown, total: all.length });
      };

      /* A compact window of page numbers: 1 … (p-1) p (p+1) … last. */
      const pageWindow = (page, last) => {
        if (last <= 7) {
          return Array.from({ length: last }, (_, i) => i + 1);
        }
        const window = [1];
        if (page > 3) window.push('gap');
        for (let p = Math.max(2, page - 1); p <= Math.min(last - 1, page + 1); p += 1) {
          window.push(p);
        }
        if (page < last - 2) window.push('gap');
        window.push(last);
        return window;
      };

      const control = (label, page, options) => {
        const settings = options || {};
        const el = document.createElement('a');
        el.className = 'in-pagination__btn';
        el.textContent = label;

        if (settings.disabled) {
          /* No href at all: a control that cannot go anywhere must not be a
             link, must not be focusable, and must not be clickable — so it is
             not given a target and is never wired to the click handler. */
          el.setAttribute('aria-disabled', 'true');
          el.setAttribute('role', 'link');
          return el;
        }

        el.href = page <= 1 ? base : base + '?page=' + page;
        el.dataset.pageTarget = String(page);

        if (settings.current) {
          el.classList.add('is-current');
          el.setAttribute('aria-current', 'page');
        }
        if (settings.numbered) {
          /* A bare "3" between two arrows is ambiguous read aloud; the visible
             label stays a number and the accessible name says what it is. */
          el.setAttribute('aria-label', fill(words.page, { n: page }));
        }
        return el;
      };

      const renderControls = (page, last) => {
        nav.innerHTML = '';

        if (last <= 1) {
          nav.hidden = true;
          return;
        }
        nav.hidden = false;

        nav.appendChild(control(words.prev, page - 1, { disabled: page === 1 }));

        pageWindow(page, last).forEach((entry) => {
          if (entry === 'gap') {
            const gap = document.createElement('span');
            gap.className = 'in-pagination__gap';
            gap.textContent = words.gap;
            gap.setAttribute('aria-hidden', 'true');
            nav.appendChild(gap);
            return;
          }
          nav.appendChild(
            control(String(entry), entry, {
              current: entry === page,
              numbered: true,
            })
          );
        });

        nav.appendChild(control(words.next, page + 1, { disabled: page === last }));
      };

      /* `replaceState`, not `pushState`: moving between pages of one directory
         is not a journey the back button should have to walk back through. A
         visitor who arrives at `?page=2` and presses back leaves the page — which
         is what they expect, and what the control band's `href`s make possible
         for a crawler or a modified click. */
      const render = (page) => {
        const last = lastPage();
        const current = Math.min(Math.max(1, page), last);

        show(current);
        renderControls(current, last);

        const url = new URL(window.location.href);
        if (current === 1) url.searchParams.delete('page');
        else url.searchParams.set('page', current);
        window.history.replaceState(null, '', url);
      };

      nav.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('[data-page-target]');
        if (!button) return;

        /* A modified click is the visitor asking for a new tab — let the browser
           have it; the href is a real address for that page of the directory. */
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        event.preventDefault();
        render(Number(button.dataset.pageTarget));

        /* The grid, not the top of the page: the visitor pressed a control that
           belongs to the directory and should stay in it. Offset by the sticky
           header. */
        const top = grid.getBoundingClientRect().top + window.scrollY - 96;
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top, behavior: still ? 'auto' : 'smooth' });
      });

      window.addEventListener('popstate', () => render(pageFromLocation()));

      render(pageFromLocation());
    }
  }
</script>
