---
/**
 * InsightsDirectory — §4's category filter + §5's article directory
 * ---------------------------------------------------------------------------
 * One band, because §4 and §5 are one device: §4 names seven filter states and
 * §5 gives the grid its eyebrow, heading and supporting line, and a filter has
 * nowhere to sit except above the thing it filters.
 *
 * ── THE FILTER IS LINKS, ENHANCED — NOT BUTTONS ────────────────────────────
 * Every chip is an `<a href>` to the real destination, so:
 *   · §9's `?category=` topic links and these chips are the SAME mechanism, as
 *     §9 allows ("if query-parameter filtering is not implemented, use the same
 *     category state/filter mechanism already used on the page");
 *   · the chip is focusable, keyboard-operable and copy-and-pasteable for free;
 *   · with JavaScript off the chip still does something useful — it navigates
 *     to the same page, which then renders the full library.
 * The script below then upgrades that: it filters in place, keeps the URL in
 * step with `pushState`, and answers the back button. With scripting off the
 * page shows all twelve and the "All" chip is marked current — which is the
 * honest fallback, not a broken one: nothing is hidden from a visitor who never
 * sees a filter happen.
 *
 * ── WHY THE ACTIVE STATE IS `aria-current` AND NOT A COLOR ─────────────────
 * §18 requires that color is not the only way to signal the selection. The
 * stylesheet therefore inverts the selected chip (light text on the ink surface,
 * a luminance change rather than a hue shift) AND changes its border and weight,
 * and `aria-current="true"` carries it to assistive technology. Three signals,
 * one of which is not color.
 *
 * ── THE REVEAL TRAP, AND WHY THE GRID IS THE GROUP ─────────────────────────
 * `.js-reveal [data-reveal]` sets `opacity: 0` on an element until an
 * IntersectionObserver adds `.is-revealed` — and an element that is
 * `display: none` never intersects, so a card hidden by the filter and later
 * filtered back in would come back INVISIBLE and stay that way. Putting the
 * reveal state on the CONTAINER instead (`data-reveal-group`, whose `.is-revealed`
 * is inherited by every child) removes the failure: the grid is revealed once,
 * and a card re-shown after that is immediately visible. This is why the flag is
 * on the `<ul>` and not on each `<li>`.
 *
 * ── WHY THE STATUS LINE EXISTS ─────────────────────────────────────────────
 * Filtering is a visual-only change: a screen-reader user who activates a chip
 * gets no feedback at all, and the card count is the whole point of the control.
 * The `role="status"` region is visually hidden and updated with "N insights
 * shown". §4's "do not display empty category messages prominently" is
 * respected by there being no visible empty state at all — and by every
 * category holding at least one article, which `insights-articles.js` derives
 * and the gate asserts.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import InsightCard from './InsightCard.astro';
import { categoryFor, DEFAULT_CATEGORY } from '../../data/insights-articles.js';

interface Props {
  directory: {
    eyebrow: string;
    title: string;
    description: string;
    filterLabel: string;
    categories: Array<{ slug: string; label: string; tag: string | null }>;
    articles: Array<{
      slug: string;
      title: string;
      description: string;
      imageKey: string | null;
      categorySlug: string;
    }>;
  };
  tone: 'ivory' | 'white';
  titleId: string;
}

const { directory, tone, titleId } = Astro.props;

/* The href for a filter chip. "All" goes to the bare route rather than
   `?category=all`, so the unfiltered URL stays the canonical one and a search
   engine sees exactly one address for the page. */
const chipHref = (categorySlug) =>
  categorySlug === DEFAULT_CATEGORY ? '/insights' : `/insights?category=${categorySlug}`;
---

<section class={`section section--${tone} in-directory`} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader
      id={titleId}
      eyebrow={directory.eyebrow}
      title={directory.title}
      lead={directory.description}
      class="in-directory__head"
    />

    <nav class="in-filter" aria-label={directory.filterLabel} data-insight-filter>
      <ul class="in-filter__list" role="list">
        {
          directory.categories.map((category) => (
            <li class="in-filter__item">
              <a
                class="in-filter__chip"
                href={chipHref(category.slug)}
                data-filter-category={category.slug}
                aria-current={category.slug === DEFAULT_CATEGORY ? 'true' : undefined}
              >
                {category.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="visually-hidden" role="status" data-insight-status></p>

    <ul class="in-grid" data-insight-grid data-reveal-group>
      {
        directory.articles.map((article) => (
          <InsightCard
            article={article}
            category={categoryFor(article.categorySlug)}
            href={`/insights/${article.slug}`}
          />
        ))
      }
    </ul>
  </div>
</section>

<script>
  /* ---------------------------------------------------------------------------
     Category filter — progressive enhancement over the chips above.

     The server renders all twelve cards and marks "All" current. Everything
     below is additive: if it never runs, the page is a complete, readable,
     crawlable directory.
     ------------------------------------------------------------------------- */
  const filter = document.querySelector('[data-insight-filter]');
  const grid = document.querySelector('[data-insight-grid]');

  if (filter && grid) {
    const chips = Array.from(filter.querySelectorAll('[data-filter-category]'));
    const cards = Array.from(grid.querySelectorAll('[data-article-category]'));
    const status = document.querySelector('[data-insight-status]');

    /* Every state a chip can ask for. A `?category=` value outside this set
       falls back to the default rather than emptying the grid — a stale or
       mistyped link should show the library, not nothing. */
    const known = new Set(chips.map((chip) => chip.dataset.filterCategory));
    const DEFAULT = 'all';

    const apply = (requested) => {
      const wanted = known.has(requested) ? requested : DEFAULT;

      let shown = 0;
      for (const card of cards) {
        const match = wanted === DEFAULT || card.dataset.articleCategory === wanted;
        card.hidden = !match;
        if (match) shown += 1;
      }

      for (const chip of chips) {
        if (chip.dataset.filterCategory === wanted) chip.setAttribute('aria-current', 'true');
        else chip.removeAttribute('aria-current');
      }

      if (status) {
        status.textContent = shown + (shown === 1 ? ' insight shown' : ' insights shown');
      }

      return wanted;
    };

    const fromLocation = () =>
      new URLSearchParams(window.location.search).get('category') || DEFAULT;

    /* Apply the URL on load, so §9's topic links land on a filtered page. */
    apply(fromLocation());

    filter.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const chip = event.target.closest('[data-filter-category]');
      if (!chip) return;

      /* A modified click is the visitor asking for a new tab or window — let the
         browser have it; the href is a real, filterable permalink. */
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

      event.preventDefault();
      const wanted = apply(chip.dataset.filterCategory);
      const href = chip.getAttribute('href');
      if (href) window.history.pushState({ category: wanted }, '', href);
    });

    /* The back button has to undo a filter, or the history entry the pushState
       above created is a lie. */
    window.addEventListener('popstate', () => apply(fromLocation()));
  }
</script>
