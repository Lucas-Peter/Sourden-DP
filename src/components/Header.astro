---
/**
 * Header — spec §6
 * Sticky. Desktop: wordmark + inline nav + CTA. Mobile: wordmark + toggle.
 * Desktop height ~80px, mobile 68px — both driven by tokens.
 *
 * The far-right CTA is a WhatsApp chat link (`navCta`), an owner-requested
 * deviation from spec §6's "no WhatsApp in the header". Everything else spec
 * §6 asked to leave out — phone, login, cart, currency/language selectors —
 * is still absent.
 */
import Button from './Button.astro';
import MobileMenu from './MobileMenu.astro';
import { nav, navCta } from '../data/site.js';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${'SOURDEN'} — home`}>SOURDEN</a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="site-nav__list">
        {
          nav.map((item) =>
            item.children && item.children.length ? (
              <li class="site-nav__item has-children">
                <a
                  class={[
                    'site-nav__link',
                    isCurrent(item.href) ? 'is-current' : '',
                  ]
                    .filter(Boolean)
                    .join(' ')}
                  href={item.href}
                  aria-haspopup="true"
                >
                  <span>{item.label}</span>
                  <span class="site-nav__chevron" aria-hidden="true"></span>
                </a>

                <div class="site-nav__sub">
                  <ul class="site-nav__sub-list">
                    {
                      item.children.map((child) => (
                        <li class="site-nav__sub-item">
                          <a
                            class="site-nav__sub-link"
                            href={child.href}
                            aria-current={isCurrent(child.href) ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a
                  class="site-nav__link"
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button
        class="site-header__cta"
        href={navCta.href}
        label={navCta.label}
        size="sm"
        external
      />

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="menu-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<script>
  /* ---------------------------------------------------------------------
     Header chrome: scroll state + accessible mobile menu.
     Deliberately plain ES5-compatible JavaScript — no framework, no library,
     and no TypeScript syntax, so the shipped bundle stays tiny.
     ------------------------------------------------------------------- */

  /* 1. Divider appears only after the page has moved. */
  var header = document.querySelector('[data-header]');
  if (header) {
    var ticking = false;
    var sync = function () {
      header.classList.toggle('is-scrolled', window.scrollY > 4);
      ticking = false;
    };
    sync();
    window.addEventListener(
      'scroll',
      function () {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(sync);
      },
      { passive: true }
    );
  }

  /* 2. Mobile menu. */
  var toggle = document.querySelector('[data-menu-toggle]');
  var panel = document.querySelector('[data-menu-panel]');

  if (toggle && panel) {
    /* Everything behind the panel is made `inert` while it is open, so
       keyboard focus cannot wander into invisible content. Browsers without
       `inert` simply skip this step — the menu still works. */
    var behind = [
      document.querySelector('main'),
      document.querySelector('footer'),
      document.querySelector('.sticky-cta'),
    ].filter(Boolean);

    var setOpen = function (open, restoreFocus) {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('is-open', open);
      document.body.classList.toggle('is-menu-open', open);

      behind.forEach(function (el) {
        if ('inert' in el) el.inert = open;
      });

      var firstLink = panel.querySelector('a, button');

      if (open) {
        if (firstLink) firstLink.focus({ preventScroll: true });
      } else if (restoreFocus) {
        toggle.focus({ preventScroll: true });
      }
    };

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    /* Escape closes and returns focus to the toggle. */
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      if (!panel.classList.contains('is-open')) return;
      setOpen(false, true);
    });

    /* Following a link inside the panel closes it without stealing focus. */
    panel.addEventListener('click', function (event) {
      if (event.target.closest('a')) setOpen(false);
    });

    /* Crossing into the desktop breakpoint resets the panel. */
    var desktop = window.matchMedia('(min-width: 1200px)');
    desktop.addEventListener('change', function (event) {
      if (event.matches) setOpen(false);
    });
  }

  /* 3. Second-level navigation — the mobile accordion only. A toggle button
     controls a panel by `aria-controls`, and the panel is shown with the
     `hidden` attribute (no author `display` on it, so `[hidden]` keeps its
     native effect). The desktop dropdown is CSS-only (hover / focus-within)
     and carries no `data-nav-toggle`, so this script never touches it. */
  var navToggles = Array.prototype.slice.call(document.querySelectorAll('[data-nav-toggle]'));

  var closeSub = function (trigger) {
    var id = trigger.getAttribute('aria-controls');
    var panelEl = id ? document.getElementById(id) : null;
    trigger.setAttribute('aria-expanded', 'false');
    if (panelEl) panelEl.hidden = true;
  };

  var closeAllSubs = function () {
    navToggles.forEach(closeSub);
  };

  navToggles.forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var id = trigger.getAttribute('aria-controls');
      var panelEl = id ? document.getElementById(id) : null;
      if (!panelEl) return;
      var willOpen = trigger.getAttribute('aria-expanded') !== 'true';
      closeAllSubs();
      if (willOpen) {
        trigger.setAttribute('aria-expanded', 'true');
        panelEl.hidden = false;
      }
    });
  });

  /* A click anywhere outside a nav item closes every open sub-level. The
     mobile panel's own handler still closes the panel itself on a link. */
  document.addEventListener('click', function (event) {
    if (event.target.closest('[data-nav-item]')) return;
    closeAllSubs();
  });

  /* Escape closes any open sub-level. (The mobile panel closes itself through
     the handler above, which runs on the same key.) */
  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    closeAllSubs();
  });
</script>
