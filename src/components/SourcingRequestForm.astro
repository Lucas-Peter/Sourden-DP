---
/**
 * SourcingRequestForm — the page's reason to exist
 * ---------------------------------------------------------------------------
 * A deliberately short form. Visitors supply five required things — name,
 * email, phone, country and a description of what they want — plus two optional
 * details (company type and where they are in the process), and the real
 * conversation continues on WhatsApp or by email (spec §16, and the brief the
 * page is built around).
 *
 * WHY THE LOGIC IS NOT IN THIS FILE
 *   Validation, the payload shape and the submit call live in src/lib/inquiry.ts
 *   as pure functions with no DOM access, so the same rules can run again on
 *   the server (spec §36).
 *
 * STATE HANDLING
 *   · A validation failure lists the problems and links each to its field, and
 *     NEVER clears what was typed.
 *   · A submission failure keeps every value, names the direct contact routes,
 *     and offers the whole brief as a mail draft so a failed submission is not
 *     a dead end.
 *   · Success is only shown when the request actually returned 2xx.
 * ---------------------------------------------------------------------------
 */
import ArrowLink from './ArrowLink.astro';
import Button from './Button.astro';
import TurnstileWidget from './TurnstileWidget.astro';
import FormField from './form/FormField.astro';

import { site } from '../data/site.js';
import { fields, formIntro, states, submitSection } from '../data/sourcing-request.js';
---

<section class="section section--white sr-brief" aria-labelledby="sr-brief-title">
  <div class="container sr-brief__inner">
    <div class="sr-intro">
      <p class="eyebrow">{formIntro.eyebrow}</p>
      <h2 class="sr-intro__title" id="sr-brief-title">{formIntro.title}</h2>
      <p class="sr-intro__lead">{formIntro.supporting}</p>
      <p class="sr-intro__note">{formIntro.requiredNote}</p>
    </div>

    {/* Validation summary — hidden until a submit attempt fails validation.
        tabindex="-1" so the script can move focus here. */}
    <div class="sr-alert sr-alert--warning" data-validation-summary role="alert" tabindex="-1" hidden>
      <p class="sr-alert__title" data-validation-title></p>
      <ul class="sr-alert__list" data-validation-list></ul>
    </div>

    {/* Submission failure — keeps the visitor out of a dead end. */}
    <div class="sr-alert sr-alert--error" data-submit-error role="alert" tabindex="-1" hidden>
      <p class="eyebrow">{states.error.eyebrow}</p>
      <h2 class="sr-alert__title">{states.error.title}</h2>
      <p class="sr-alert__body" data-submit-error-body>{states.error.body}</p>

      <p class="sr-alert__direct">{states.error.directTitle}</p>
      <ul class="sr-alert__contacts">
        <li>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <a href={site.whatsapp.href} target="_blank" rel="noopener noreferrer">
            WhatsApp
          </a>
        </li>
      </ul>

      <p class="sr-alert__fallback">
        <a data-mailto-link href={`mailto:${site.email}`}>Send this request by email instead →</a>
      </p>
    </div>

    <form
      class="sr-form"
      data-inquiry-form
      data-contact-email={site.email}
      method="post"
      action="/api/inquiry"
      novalidate
    >
      <FormField id="sr-name" label={fields.name.label} required>
        <input
          class="sr-input"
          id="sr-name"
          name="name"
          type="text"
          autocomplete="name"
          aria-describedby="sr-name-error"
        />
      </FormField>

      <FormField id="sr-email" label={fields.email.label} required>
        <input
          class="sr-input"
          id="sr-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder={fields.email.placeholder}
          aria-describedby="sr-email-error"
        />
      </FormField>

      <FormField id="sr-phone" label={fields.phone.label} required>
        <input
          class="sr-input"
          id="sr-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder={fields.phone.placeholder}
          aria-describedby="sr-phone-error"
        />
      </FormField>

      <FormField id="sr-country" label={fields.country.label} required>
        <input
          class="sr-input"
          id="sr-country"
          name="country"
          type="text"
          autocomplete="country-name"
          placeholder={fields.country.placeholder}
          aria-describedby="sr-country-error"
        />
      </FormField>

      <FormField id="sr-company" label={fields.companyType.label}>
        <input
          class="sr-input"
          id="sr-company"
          name="companyType"
          type="text"
          autocomplete="organization"
          placeholder={fields.companyType.placeholder}
          aria-describedby="sr-company-error"
        />
      </FormField>

      <FormField id="sr-stage" label={fields.stage.label}>
        <input
          class="sr-input"
          id="sr-stage"
          name="stage"
          type="text"
          placeholder={fields.stage.placeholder}
          aria-describedby="sr-stage-error"
        />
      </FormField>

      <FormField id="sr-message" label={fields.message.label} required class="sr-field--wide">
        <textarea
          class="sr-textarea"
          id="sr-message"
          name="message"
          rows="6"
          placeholder={fields.message.placeholder}
          aria-describedby="sr-message-error"></textarea>
      </FormField>

      <div class="sr-submit" id="sr-submit">
        <div class="sr-submit__head">
          <p class="eyebrow">{submitSection.eyebrow}</p>
          <h2 class="sr-submit__title">{submitSection.title}</h2>
          <p class="sr-submit__lead">{submitSection.supporting}</p>
        </div>

        <TurnstileWidget />

        <div class="sr-submit__actions">
          <button class="btn sr-submit__button" type="submit" data-submit-button>
            <span data-submit-label>{submitSection.button}</span>
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
        </div>

        {/* aria-live so the submitting state is announced, not just drawn. */}
        <p class="sr-submit__status" data-submit-status aria-live="polite"></p>

        <p class="sr-submit__fineprint">
          We use what you send us to reply to this request. Nothing else, and never sold on.
        </p>
      </div>
    </form>

    {/* Success — replaces the form. Never rendered visible on first paint. */}
    <div class="sr-success" data-success-view tabindex="-1" hidden>
      <p class="eyebrow">{states.success.eyebrow}</p>
      <h2 class="sr-success__title">{states.success.title}</h2>
      <p class="sr-success__body">{states.success.body}</p>
      <p class="sr-success__secondary">{states.success.secondary}</p>

      <div class="sr-success__actions">
        <Button href="/" label={states.success.home} arrow />
        <ArrowLink href="/services" label={states.success.services} />
      </div>
    </div>
  </div>
</section>

<script>
  import {
    buildPayload,
    buildRequestSummary,
    submitInquiry,
    track,
    validate,
  } from '../lib/inquiry';
  import type { FieldErrors, InquiryValues } from '../lib/inquiry';
  import { states, submitSection, validationMessages } from '../data/sourcing-request.js';

  const form = document.querySelector<HTMLFormElement>('[data-inquiry-form]');

  if (form) {
    /* ------------------------------------------------------------ elements */
    const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const submitStatus = form.querySelector<HTMLElement>('[data-submit-status]');

    const summaryBox = document.querySelector<HTMLElement>('[data-validation-summary]');
    const summaryTitle = document.querySelector<HTMLElement>('[data-validation-title]');
    const summaryList = document.querySelector<HTMLElement>('[data-validation-list]');

    const errorBox = document.querySelector<HTMLElement>('[data-submit-error]');
    const errorBody = document.querySelector<HTMLElement>('[data-submit-error-body]');
    const mailtoLink = document.querySelector<HTMLAnchorElement>('[data-mailto-link]');
    const successView = document.querySelector<HTMLElement>('[data-success-view]');

    const turnstile = document.querySelector<HTMLElement>('[data-turnstile]');

    /* --------------------------------------------------------------- state */
    let submitting = false;
    let started = false;
    const openedAt = Date.now();

    track('view_sourcing_request');

    /* ------------------------------------------------------------- reading */
    function readValues(): InquiryValues {
      const valueOf = (name: string): string => {
        const control = form!.elements.namedItem(name);
        if (
          control instanceof HTMLInputElement ||
          control instanceof HTMLTextAreaElement
        ) {
          return control.value;
        }
        return '';
      };

      return {
        name: valueOf('name'),
        email: valueOf('email'),
        phone: valueOf('phone'),
        country: valueOf('country'),
        companyType: valueOf('companyType'),
        stage: valueOf('stage'),
        message: valueOf('message'),
      };
    }

    /* -------------------------------------------------------------- errors */
    function clearFieldError(controlId: string): void {
      const error = document.getElementById(`${controlId}-error`);
      const control = document.getElementById(controlId);
      if (error) {
        error.textContent = '';
        error.hidden = true;
      }
      control?.removeAttribute('aria-invalid');
    }

    function applyErrors(errors: FieldErrors): number {
      form!.querySelectorAll<HTMLElement>('.sr-field__error').forEach((node) => {
        node.textContent = '';
        node.hidden = true;
      });
      form!.querySelectorAll<HTMLElement>('[aria-invalid="true"]').forEach((node) => {
        node.removeAttribute('aria-invalid');
      });

      const entries = Object.entries(errors) as Array<[keyof InquiryValues, string]>;
      if (entries.length === 0) {
        if (summaryBox) summaryBox.hidden = true;
        return 0;
      }

      if (summaryList) summaryList.textContent = '';
      if (summaryTitle) summaryTitle.textContent = validationMessages.summaryTitle;

      for (const [field, text] of entries) {
        const control = form!.querySelector<HTMLElement>(`[name="${field}"]`);
        if (!control) continue;

        control.setAttribute('aria-invalid', 'true');

        // Every control's error line is `<control id>-error`.
        const error = document.getElementById(`${control.id}-error`);
        if (error) {
          error.textContent = text;
          error.hidden = false;
        }

        if (summaryList) {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = `#${control.id}`;
          link.textContent = text;
          link.addEventListener('click', (event) => {
            event.preventDefault();
            control.focus();
          });
          li.append(link);
          summaryList.append(li);
        }
      }

      if (summaryBox) {
        summaryBox.hidden = false;
        summaryBox.focus();
      }

      return entries.length;
    }

    /* ------------------------------------------------------------- states */
    function setSubmitting(state: boolean): void {
      submitting = state;
      form!.setAttribute('aria-busy', state ? 'true' : 'false');

      // Every control is locked while the request is in flight.
      form!.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(
        (control) => {
          control.disabled = state;
        }
      );

      if (submitButton) submitButton.disabled = state;
      if (submitLabel) {
        submitLabel.textContent = state ? submitSection.submitting : submitSection.button;
      }
      if (submitStatus) submitStatus.textContent = state ? submitSection.submitting : '';
    }

    function showSubmissionError(values: InquiryValues | null): void {
      if (!errorBox) return;

      if (values && mailtoLink) {
        const summary = buildRequestSummary(values);
        // mailto URLs are length-limited by the OS handler; keep well clear.
        const clipped = summary.length > 1600 ? `${summary.slice(0, 1600)}\n…` : summary;
        const subject = `Sourcing request — ${values.name.trim() || 'New enquiry'}`;
        mailtoLink.href =
          `mailto:${form!.dataset.contactEmail ?? ''}` +
          `?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(clipped)}`;
      }

      errorBox.hidden = false;
      errorBox.focus();
    }

    function showSuccess(): void {
      form!.hidden = true;
      if (summaryBox) summaryBox.hidden = true;
      if (errorBox) errorBox.hidden = true;

      if (successView) {
        successView.hidden = false;
        successView.focus();
      }
    }

    /* ------------------------------------------------------------- submit */
    function markStarted(): void {
      if (started) return;
      started = true;
      track('start_sourcing_request');
    }

    form.addEventListener('input', markStarted, { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      if (errorBody) errorBody.textContent = states.error.body;

      // A configured Turnstile must be solved before anything is sent.
      const tokenControl = form.querySelector<HTMLInputElement>(
        'input[name="cf-turnstile-response"]'
      );
      if (turnstile && !tokenControl?.value) {
        if (errorBody) errorBody.textContent = validationMessages.turnstileRequired;
        showSubmissionError(null);
        return;
      }

      const values = readValues();
      const errors = validate(values, validationMessages);
      const errorCount = applyErrors(errors);

      if (errorCount > 0) {
        track('sourcing_request_error', {
          reason: 'validation',
          errorFields: Object.keys(errors).join(','),
        });
        return;
      }

      setSubmitting(true);

      try {
        const payload = buildPayload(values, tokenControl?.value ?? '');
        track('submit_sourcing_request', {});

        const outcome = await submitInquiry(payload);

        if (outcome.ok) {
          track('sourcing_request_success', { durationMs: Date.now() - openedAt });
          showSuccess();
          return;
        }

        if (errorBody) errorBody.textContent = states.error.body;
        showSubmissionError(values);
        track('sourcing_request_error', {
          reason: outcome.reason,
          status: outcome.status ?? 0,
        });
      } catch {
        if (errorBody) errorBody.textContent = states.error.body;
        showSubmissionError(values);
        track('sourcing_request_error', { reason: 'unexpected' });
      } finally {
        setSubmitting(false);
      }
    });
  }
</script>
