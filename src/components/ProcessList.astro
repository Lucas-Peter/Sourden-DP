---
/**
 * ProcessList — spec §9 "What We Do"
 * Editorial vertical list of the sourcing workflow. Thin borders, ~62px rows.
 *
 * Desktop hover: slight horizontal movement + a brass line that grows along the
 * row. No hover is required to read anything — every label is always visible,
 * which is what makes the mobile experience correct by default (spec §21).
 *
 * Optional per-row image preview (spec §9) is not implemented: it is marked
 * optional and would cost five extra image requests on a trust page.
 */
import SectionHeader from './SectionHeader.astro';
import { whatWeDoIntro, whatWeDoSteps } from '../data/process.js';
---

<section class="section what-we-do" aria-labelledby="what-we-do-title">
  <div class="container">
    <div class="grid what-we-do__grid">
      <div class="what-we-do__head" data-reveal>
        <SectionHeader
          id="what-we-do-title"
          eyebrow={whatWeDoIntro.eyebrow}
          title={whatWeDoIntro.title}
          lead={whatWeDoIntro.supporting}
        />
      </div>

      <div class="what-we-do__list-col" data-reveal-group>
        <ol class="rows what-we-do__list">
          {
            whatWeDoSteps.map((step) => (
              <li class="process-row">
                <span class="num">{step.number}</span>
                <h3 class="process-row__title">{step.title}</h3>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
