---
/**
 * CaseStudies — homepage section (spec §17 discipline, 2026-10-02 layout)
 * A PROOF section, not a marketing-statistics section.
 *
 * Layout: one large featured case + two smaller entries in an editorial
 * composition — never a standard 3-card grid.
 *
 * HOMEPAGE-ONLY: no /case-studies pages exist, so no entry links anywhere and
 * there is no "View All" link. Entries are scenarios, never dressed up as
 * customer projects (spec §39, §43).
 */
import SectionHeader from './SectionHeader.astro';
import CaseStudyFeature from './CaseStudyFeature.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import {
  caseStudiesIntro,
  featuredCaseStudy,
  secondaryCaseStudies,
} from '../data/caseStudies.js';
---

<section class="section case-studies" aria-labelledby="case-studies-title">
  <div class="container">
    <div class="case-studies__head" data-reveal>
      <SectionHeader
        id="case-studies-title"
        eyebrow={caseStudiesIntro.eyebrow}
        title={caseStudiesIntro.title}
        lead={caseStudiesIntro.supporting}
      />
      <p class="case-studies__notice">{caseStudiesIntro.notice}</p>
    </div>

    <div class="case-studies__grid">
      <CaseStudyFeature study={featuredCaseStudy} />

      <div class="case-secondary-col" data-reveal-group>
        {secondaryCaseStudies.map((study) => <CaseStudyCard study={study} />)}
      </div>
    </div>
  </div>
</section>
