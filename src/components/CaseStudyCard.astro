---
/**
 * CaseStudyCard — a secondary entry of the homepage Case Studies section.
 * A plain card, NOT a link: there are no /case-studies detail pages
 * (2026-10-02). Same honest-content discipline as the featured card.
 */
import Media from './Media.astro';

interface Study {
  number: string;
  title: string;
  summary: string;
  images: Array<{ key: string; caption: string | null }>;
  scope: string[];
}

interface Props {
  study: Study;
}

const { study } = Astro.props;

const imageKey = study.images?.[0]?.key;
---

<article class="case-secondary">
    {imageKey && <Media imageKey={imageKey} ratio="3x2" zoom />}

    <div class="case-secondary__body">
      <span class="num">{study.number}</span>
      <h3 class="case-secondary__title">{study.title}</h3>

      {
        study.scope.length > 0 && (
          <span class="case-secondary__scope">
            {study.scope.map((tag) => (
              <span>{tag}</span>
            ))}
          </span>
        )
      }

      <p class="case-secondary__summary">{study.summary}</p>
    </div>
</article>
