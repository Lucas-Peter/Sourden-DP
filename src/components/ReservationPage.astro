---
/**
 * ReservationPage — the shell for every route reserved by spec §33 whose
 * content is not written yet.
 *
 * WHY THIS EXISTS
 * The spec requires the site's full URL architecture up front, and requires
 * that navigation and every internal link work (spec §43). It also forbids
 * inventing content. A reservation page satisfies both: the route resolves, the
 * page reads as a real page in the brand's voice, and it states plainly what is
 * still to come rather than pretending to be finished.
 *
 * SEO
 * These pages carry `noindex` and are excluded from sitemap.xml via the route
 * registry. When a page is built for real, remove its entry from
 * `reservedTopLevel` in `src/data/routes.js` — it re-enters the sitemap
 * automatically.
 *
 * When copying this into a real page, keep the shell (BaseLayout, hero,
 * breadcrumb) and replace the `.reserved-*` body with real content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
/* Imported AFTER the layout (see the note in src/pages/*.astro) so this
   stylesheet keeps the higher precedence. The shell owns these styles, so
   every page that renders it gets them and none can forget to. */
import '../styles/inner-pages.css';
import Button from './Button.astro';
import ArrowLink from './ArrowLink.astro';
import { site, primaryCta } from '../data/site.js';
import { reservationNotice } from '../data/routes.js';
import { webPageSchema, breadcrumbSchema } from '../data/schema.js';

interface Props {
  /** Root-relative route, used for canonical + og:url. */
  path: string;
  seoTitle: string;
  seoDescription: string;
  eyebrow: string;
  h1: string;
  summary: string;
  /** What the finished page will contain. */
  planned?: string[];
  /** Child routes that already resolve, e.g. the five service pages. */
  linkList?: {
    title: string;
    items: Array<{ label: string; href: string }>;
  };
  /** Breadcrumb trail excluding "Home", which is added automatically. */
  breadcrumbs?: Array<{ label: string; href?: string }>;
}

const {
  path,
  seoTitle,
  seoDescription,
  eyebrow,
  h1,
  summary,
  planned = [],
  linkList,
  breadcrumbs = [],
} = Astro.props;

const trail = [{ label: 'Home', href: '/' }, ...breadcrumbs];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  path={path}
  noindex
  schema={[
    webPageSchema({ title: seoTitle, description: seoDescription, path }),
    breadcrumbSchema(trail),
  ]}
>
  <section class="reserved-hero">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          {
            trail.map((crumb, index) => (
              <li>
                {crumb.href ? (
                  <a href={crumb.href}>
                    <span class="breadcrumb__label">{crumb.label}</span>
                  </a>
                ) : (
                  <span aria-current="page">{crumb.label}</span>
                )}
                {index < trail.length - 1 && (
                  <span class="breadcrumb__sep" aria-hidden="true">
                    /
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="reserved-hero__head">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="reserved-hero__title">{h1}</h1>
        <p class="reserved-hero__summary">{summary}</p>
      </div>
    </div>
  </section>

  <section class="section reserved-body">
    <div class="container container--narrow reserved-body__inner">
      <div class="reserved-notice">
        <p class="reserved-notice__label">{reservationNotice.label}</p>
        <p class="reserved-notice__body">{reservationNotice.body}</p>
      </div>

      {
        planned.length > 0 && (
          <div class="reserved-block">
            <h2 class="reserved-block__title">What this page will cover</h2>
            <ul class="reserved-list">
              {planned.map((item) => (
                <li class="reserved-list__item">
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        linkList && (
          <div class="reserved-links">
            <h2 class="reserved-block__title">{linkList.title}</h2>
            <ul class="reserved-links__list">
              {linkList.items.map((item) => (
                <li class="reserved-links__item">
                  <a class="reserved-links__link" href={item.href}>
                    <span>{item.label}</span>
                    <span class="reserved-links__arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="reserved-actions">
        <div class="reserved-actions__primary">
          <Button href={primaryCta.href} label={primaryCta.label} />
          <ArrowLink href="/" label="Back to Home" />
        </div>
        <p class="reserved-actions__email">
          Or email <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
