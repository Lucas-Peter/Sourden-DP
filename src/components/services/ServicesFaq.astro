---
/**
 * ServicesFaq — the services-area FAQ disclosure group
 * ---------------------------------------------------------------------------
 * A column of questions, an optional closing link. Used by `/services` and by
 * the `/services/<slug>` detail pages.
 *
 * WHY ALL COPY IS REQUIRED
 *   This component used to read `services-page.js` directly. When the detail
 *   pages needed the same device the choice was to duplicate the markup or to
 *   pass the copy in; this follows the `FinalCTA` precedent, so nothing is
 *   optional except the trailing link — while copy had defaults, a page could
 *   render the FAQ and silently inherit another page's questions.
 *
 * WHY <details> AND NOT A SCRIPTED ACCORDION
 *   The brief says to use the existing accordion component "if available" — the
 *   site has none, and it should not gain one. Native <details>/<summary> is
 *   keyboard-operable, announces its expanded state, is reachable by in-page
 *   search (Ctrl+F finds answers inside a closed <details> in every current
 *   browser) and works with JavaScript disabled or broken. A scripted accordion
 *   would be strictly worse on all four counts. There is deliberately no
 *   <script> block in this component and no `open` state managed in JS, so the
 *   answer text is always present in the served HTML.
 *
 * WHY THE FIRST ITEM IS OPEN
 *   A column of entirely closed rows gives a visitor nothing to read and makes
 *   the section look like a form. On both the overview page and every detail
 *   page the question left open is the one a first-time buyer asks first.
 *
 * WHY items ARE NOT GROUPED EXCLUSIVELY
 *   The HTML `name` attribute would make them behave as a radio group (only one
 *   open at a time). That is worse for an FAQ: it hides answers the reader has
 *   already opened, and it is ignored by the browsers at this project's support
 *   floor anyway (Chrome 87 / Safari 14), so the experience would differ by
 *   browser for no benefit.
 *
 * The questions are <summary> text, not headings — a column of h3s would flood
 * the document outline with entries that are questions, not sections.
 *
 * WHY AN ANSWER MAY BE SEVERAL PARAGRAPHS
 *   Every answer on `/services`, the five detail pages, `/industries` and
 *   `/about` is one sentence or two in a single paragraph, so `answer` was a
 *   string. The FAQ page's brief writes almost all thirty-three of its answers
 *   as two or three separate paragraphs, and flattening them would lose the
 *   brief's own paragraphing. `answer` therefore accepts `string[]` as well;
 *   a string is still rendered as ONE <p>, byte for byte as before, so no
 *   existing caller changes.
 *
 * WHY `tone` IS OPTIONAL AND OFF BY DEFAULT
 *   `/faq` is the first page to render this device many times over — seven
 *   consecutive categories plus an in-page navigation that has to be able to
 *   scroll to each one. That needs the ground to alternate, because
 *   `.sec-faq`'s own ground is ivory and seven ivory bands in a row read as one
 *   continuous field. `tone` is opt-in: with it unset the emitted markup is
 *   identical to before, and `tone: 'ivory'` is the device's existing ground
 *   rather than a second class.
 *
 *   The scroll target needs nothing new. `titleId` already ids the heading, and
 *   a jump list wants to land on the category's HEADING — landing on the
 *   section would scroll past the section's own top padding and put the heading
 *   roughly 230px down the viewport. So `/faq` passes its own anchor strings as
 *   `titleId` (`faq-shipping`, …) and the nav points at those. Nothing about
 *   the component changed to support it.
 *
 * Styles live in `services-shared.css` (`.sec-faq*`).
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: Array<{
    question: string;
    /**
     * One paragraph, or several. A string renders as a single <p> exactly as it
     * always did; an array renders one <p> per entry. See the header note.
     */
    answer: string | string[];
    /**
     * Optional link attached to ONE answer.
     *
     * Added for `/industries`, whose brief names a destination under three of
     * its eight answers ("Can you verify the supplier?" → the Supplier
     * Verification page, and so on). Those are the three questions where the
     * honest answer is "yes, and here is the service that does it", and a
     * reader who has just asked that question is the reader most likely to
     * want it — so the link belongs to the answer, not to the section.
     *
     * It is a link rather than a sentence inside `answer` because copy may not
     * carry markup, and it is per-item rather than a section-level `foot`
     * because these three answers point at three different pages.
     */
    link?: { label: string; href: string };
  }>;
  /**
   * Section ground. The device's own ground is ivory, so `'ivory'` emits no
   * extra class and every existing caller is byte-identical. `'white'` exists
   * for `/faq`, whose seven consecutive categories have to alternate.
   */
  tone?: 'ivory' | 'white';
  /** Optional closing link. Omitted where the section is followed by a CTA. */
  foot?: { label: string; href: string };
  /**
   * Unique per page: the <section> is labelled by this id.
   *
   * `/faq` also uses it as the navigation's scroll target — see the header
   * note on why the heading, not the section, is the right landing point.
   */
  titleId?: string;
}

const { eyebrow, title, items, tone, foot, titleId = 'sec-faq-title' } = Astro.props;

/**
 * One <p> per paragraph. A string keeps rendering as a single paragraph, which
 * is what keeps the existing callers' markup unchanged.
 */
const paragraphsOf = (answer: string | string[]) =>
  Array.isArray(answer) ? answer : [answer];

const classes = ['section', 'sec-faq', tone === 'white' && 'sec-faq--white']
  .filter(Boolean)
  .join(' ');
---

<section class={classes} aria-labelledby={titleId}>
  <div class="container">
    <div class="sec-faq__grid">
      <div class="sec-faq__head">
        <SectionHeader id={titleId} eyebrow={eyebrow} title={title} />
      </div>

      <div class="sec-faq__list">
        {
          items.map((item, index) => (
            <details class="sec-faq__item" open={index === 0}>
              <summary class="sec-faq__question">
                <span class="sec-faq__question-text">{item.question}</span>
                <span class="sec-faq__mark" aria-hidden="true" />
              </summary>

              <div class="sec-faq__answer">
                {paragraphsOf(item.answer).map((paragraph) => (
                  <p>{paragraph}</p>
                ))}

                {item.link && (
                  <p class="sec-faq__answer-link">
                    <ArrowLink href={item.link.href} label={item.link.label} brass />
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>

    {
      foot && (
        <div class="section-foot sec-faq__foot">
          <ArrowLink href={foot.href} label={foot.label} brass />
        </div>
      )
    }
  </div>
</section>
