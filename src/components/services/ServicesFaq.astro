---
/**
 * ServicesFaq — the services-area FAQ disclosure group
 * ---------------------------------------------------------------------------
 * A column of questions, an optional closing link. Used by `/services` and by
 * the `/services/<slug>` detail pages.
 *
 * WHY ALL COPY IS REQUIRED
 *   This component used to read `services-page.js` directly. When the detail
 *   pages needed the same device the choice was to duplicate the markup or to
 *   pass the copy in; this follows the `FinalCTA` precedent, so nothing is
 *   optional except the trailing link — while copy had defaults, a page could
 *   render the FAQ and silently inherit another page's questions.
 *
 * WHY <details> AND NOT A SCRIPTED ACCORDION
 *   The brief says to use the existing accordion component "if available" — the
 *   site has none, and it should not gain one. Native <details>/<summary> is
 *   keyboard-operable, announces its expanded state, is reachable by in-page
 *   search (Ctrl+F finds answers inside a closed <details> in every current
 *   browser) and works with JavaScript disabled or broken. A scripted accordion
 *   would be strictly worse on all four counts. There is deliberately no
 *   <script> block in this component and no `open` state managed in JS, so the
 *   answer text is always present in the served HTML.
 *
 * WHY THE FIRST ITEM IS OPEN
 *   A column of entirely closed rows gives a visitor nothing to read and makes
 *   the section look like a form. On both the overview page and every detail
 *   page the question left open is the one a first-time buyer asks first.
 *
 * WHY items ARE NOT GROUPED EXCLUSIVELY
 *   The HTML `name` attribute would make them behave as a radio group (only one
 *   open at a time). That is worse for an FAQ: it hides answers the reader has
 *   already opened, and it is ignored by the browsers at this project's support
 *   floor anyway (Chrome 87 / Safari 14), so the experience would differ by
 *   browser for no benefit.
 *
 * The questions are <summary> text, not headings — a column of h3s would flood
 * the document outline with entries that are questions, not sections.
 *
 * Styles live in `services-shared.css` (`.sv-faq*`).
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props {
  eyebrow: string;
  title: string;
  items: Array<{
    question: string;
    answer: string;
    /**
     * Optional link attached to ONE answer.
     *
     * Added for `/industries`, whose brief names a destination under three of
     * its eight answers ("Can you verify the supplier?" → the Supplier
     * Verification page, and so on). Those are the three questions where the
     * honest answer is "yes, and here is the service that does it", and a
     * reader who has just asked that question is the reader most likely to
     * want it — so the link belongs to the answer, not to the section.
     *
     * It is a link rather than a sentence inside `answer` because copy may not
     * carry markup, and it is per-item rather than a section-level `foot`
     * because these three answers point at three different pages.
     */
    link?: { label: string; href: string };
  }>;
  /** Optional closing link. Omitted where the section is followed by a CTA. */
  foot?: { label: string; href: string };
  /** Unique per page: the <section> is labelled by this id. */
  titleId?: string;
}

const { eyebrow, title, items, foot, titleId = 'sv-faq-title' } = Astro.props;
---

<section class="section sv-faq" aria-labelledby={titleId}>
  <div class="container">
    <div class="sv-faq__grid">
      <div class="sv-faq__head">
        <SectionHeader id={titleId} eyebrow={eyebrow} title={title} />
      </div>

      <div class="sv-faq__list">
        {
          items.map((item, index) => (
            <details class="sv-faq__item" open={index === 0}>
              <summary class="sv-faq__question">
                <span class="sv-faq__question-text">{item.question}</span>
                <span class="sv-faq__mark" aria-hidden="true" />
              </summary>

              <div class="sv-faq__answer">
                <p>{item.answer}</p>

                {item.link && (
                  <p class="sv-faq__answer-link">
                    <ArrowLink href={item.link.href} label={item.link.label} brass />
                  </p>
                )}
              </div>
            </details>
          ))
        }
      </div>
    </div>

    {
      foot && (
        <div class="section-foot sv-faq__foot">
          <ArrowLink href={foot.href} label={foot.label} brass />
        </div>
      )
    }
  </div>
</section>
