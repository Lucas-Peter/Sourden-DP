---
/**
 * ServiceProcess — the numbered stages of one process, on the ink rail
 * ---------------------------------------------------------------------------
 * The detail pages' process section. Same rail device as `/services`, but the
 * stage label IS the heading here rather than a rail label above a service
 * name: on `/services` the row reads "01 — FIND" / *Product Sourcing* / …,
 * because there the stage points at a service. On a detail page the stage is a
 * step of that service, so "01 — UNDERSTAND" is the whole heading and there is
 * nothing to link to.
 *
 * FIVE STAGES IS THE COMMON CASE, NOT THE CONTRACT. The rail is as wide as
 * `steps` is long — see `stageClass` below for what a sixth stage did to a
 * five-column grid.
 *
 * WHY THE STAGE IS NOT A LINK
 *   There is no page to link to — `page.sections` is one service's own process.
 *   `/services` wraps each stage in an <a> so the whole row is one large target;
 *   here a link would be a dead end or a link to the page you are already on.
 *
 * WHY THE RAIL IS ALWAYS THE DARK BAND
 *   Each detail page uses exactly one dark band, and this is it: the process is
 *   the spine of a service page, the same role "The SOURDEN approach" plays on
 *   /services. It also solves the page's colour rhythm — the hero and the FAQ
 *   are both ivory, so without a dark band here the alternation would have to
 *   break somewhere else.
 *
 * NUMBERS ARE DERIVED FROM THE ARRAY ORDER. A step cannot be mis-numbered or
 * duplicated, and re-ordering the copy renumbers the page.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /**
   * `links` is optional on every step. `/services`' rail wraps the whole row in
   * one anchor because each stage points at exactly one service; that shape
   * cannot express a stage with two destinations, which is what
   * `/how-it-works` §02's fourth stage needs (purchasing AND quality control).
   * So a step may instead carry its destinations as a row of links under its
   * description.
   */
  steps: Array<{ label: string; description: string; links?: Array<{ label: string; href: string }> }>;
  /** Optional closing line — the caveat that qualifies the whole process. */
  note?: string;
  /**
   * Optional closing link. Added for `/industries` §10, whose brief gives the
   * band a "Start a Sourcing Request →" action; the five detail pages end their
   * rail without one (the page's own closing band follows), so this is
   * optional and absent there.
   */
  foot?: { label: string; href: string };
  /**
   * Extra class on the <section>. Every other shared component already accepts
   * one; the rail needed it when `/industries` had to reserve a second line for
   * a longer stage label — see `.ind-process .sec-stage__verb` in
   * `industries.css` for why that has to be scoped to the page. The nine
   * `/industries/<slug>` pages pass the same class for the same reason: at six
   * columns their stage labels wrap, so all six have to reserve the second line
   * or the descriptions below them stop sharing a top edge.
   */
  class?: string;
  titleId: string;
}

const {
  eyebrow,
  title,
  description,
  steps,
  note,
  foot,
  class: className = '',
  titleId,
} = Astro.props;

/**
 * The rail is exactly as wide as it has stages.
 *
 * `services-shared.css` used to hard-code five columns, which was right for
 * every consumer until the `/industries/<slug>` pages arrived with the brief's
 * SIX-stage process. A sixth stage in a five-column grid wraps onto an implicit
 * second row: the rail line stays on the first row, the sixth dot sits ~240px
 * below the other five, and the instrument reads as slightly broken rather than
 * as wrong.
 *
 * The count is published as a modifier class rather than as an inline custom
 * property, because `scripts/audit.mjs` refuses any inline `style=""` attribute
 * on purpose, and the alternative to adding a rule per count is not worth an
 * exception in the build gate. `.ind-rows--numbered` is the same shape.
 *
 * Emitted for every count, not only the non-default ones: the markup then says
 * how many stages it has, and a new count is one CSS rule with no change here.
 * A count with no rule falls back to the five-column default, which wraps — a
 * visibly wrong rail that `id-geo.mjs` fails, not a silent one.
 */
const stageClass = `sec-stages sec-stages--${steps.length}`;
---

<section class={`section section--dark sec-process-dark ${className}`.trim()} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader id={titleId} eyebrow={eyebrow} title={title} lead={description} class="sec-process-dark__head" />

    <ol class={stageClass} data-reveal-group>
      {
        steps.map((step, index) => (
          <li class="sec-stage">
            {/* `.sec-stage__body` is the non-link twin of `.sec-stage__link` in
                services-shared.css — it carries the identical grid geometry
                without the anchor semantics or the hover arrow. */}
            <div class="sec-stage__body">
              <span class="sec-stage__marker" aria-hidden="true" />

              <h3 class="sec-stage__rail sec-process-dark__step">
                <span class="num sec-stage__num">{String(index + 1).padStart(2, '0')}</span>
                <span class="sec-stage__dash" aria-hidden="true">
                  —
                </span>
                <span class="sec-stage__verb">{step.label}</span>
              </h3>

              <p class="sec-stage__desc">{step.description}</p>

              {/* Only rendered when a step actually has destinations, so the
                  four existing consumers — whose steps carry none — produce
                  byte-identical markup and an unchanged grid. The row is
                  placed in the grid's NEXT row; because that row is implicit
                  (`auto`), no `grid-template-rows` declaration had to change,
                  which is what keeps this additive rather than a re-layout. */}
              {step.links && step.links.length > 0 && (
                <div class="sec-stage__links">
                  {step.links.map((link) => (
                    <ArrowLink href={link.href} label={link.label} brass />
                  ))}
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    {note && <p class="sec-note sec-process-dark__note">{note}</p>}

    {
      foot && (
        <div class="section-foot sec-process-dark__foot">
          <ArrowLink href={foot.href} label={foot.label} brass />
        </div>
      )
    }
  </div>
</section>
