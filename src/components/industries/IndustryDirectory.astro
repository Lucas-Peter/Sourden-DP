---
/**
 * IndustryDirectory — the nine-entry category directory  (brief §03)
 * ---------------------------------------------------------------------------
 * The centre of the page, and the reason it exists: it is the navigation
 * mechanism toward the nine `/industries/<slug>` category pages, and it has to
 * be "visually important" (brief §"Implementation notes") without becoming an
 * ecommerce category grid.
 *
 * ── WHY THIS IS NOT THE HOMEPAGE GRID ─────────────────────────────────────
 * The homepage has `IndustryGrid`: nine image tiles, one category each, no
 * copy. Reusing it here would have made this page a second copy of the
 * homepage's `WHAT WE SOURCE` section — which the brief explicitly forbids
 * ("The page should NOT simply duplicate the homepage's WHAT WE SOURCE
 * section … This page should provide more context").
 *
 * So the two devices answer two different questions, and they are built the
 * opposite way round:
 *   homepage grid  → nine pictures, so the reader recognises a category
 *   this directory → nine ruled text entries with a description and a list of
 *                    real product types, so the reader can tell whether their
 *                    product is in scope before they click
 *
 * ── WHY THERE ARE NO IMAGES ───────────────────────────────────────────────
 * Nine category photographs in a nine-cell layout is a product grid, whatever
 * the surrounding copy says. The brief asks for "an editorial sourcing
 * directory, not an ecommerce category page", and the site's own rule is
 * "no product grids with fake products" — so the entry is copy-led and the
 * page carries exactly one image, its hero. It also means the directory costs
 * one text request rather than nine image requests.
 *
 * ── WHY THE ENTRY ENDS ON ITS LINK ────────────────────────────────────────
 * The "Explore …" action is the LAST thing in each entry, after the description
 * and the product types, at every width. Putting it under the title instead
 * would have read well on desktop and badly on mobile — where the stacking
 * order is what the reader actually gets, and a "go somewhere" link before the
 * sentence explaining where it goes is a link nobody has a reason to follow.
 *
 * ── WHY IT IS AN <ol> ─────────────────────────────────────────────────────
 * The nine entries are numbered 01–09 in the data and on screen. That is a
 * sequence with real positions, so it is an ordered list; the number is a
 * `<span class="num">` rather than a list marker because the numbers come from
 * `industries.js` and must not be regenerated by the browser.
 *
 * ── HEADINGS ──────────────────────────────────────────────────────────────
 * Section h2 → one h3 per category. The nine h3s are what put the categories in
 * the document outline, which is the point of a hub page: a screen reader, a
 * crawler or an AI assistant can enumerate the categories without reading the
 * copy of each entry.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: Array<{
    /** From the registry — never re-typed (e.g. `01`). */
    number: string;
    /** From the registry (e.g. `Consumer Products`). */
    title: string;
    /** From the registry — the future category page. */
    href: string;
    description: string;
    productTypes: string[];
    /** Optional per-category caveat (the brief supplies one, for Electronics). */
    note?: string;
    /** Derived in the page data: `Explore <title>`. */
    exploreLabel: string;
  }>;
  tone: 'ivory' | 'white';
  titleId: string;
}

const { eyebrow, title, description, items, tone, titleId } = Astro.props;
---

<section class={`section section--${tone} ind-directory`} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader
      id={titleId}
      eyebrow={eyebrow}
      title={title}
      lead={description}
      class="ind-directory__head"
    />

    <ol class="ind-directory__list">
      {
        items.map((item) => (
          <li class="ind-directory__item">
            <span class="num ind-directory__num">{item.number}</span>

            {/* The heading is not a link: each entry has exactly ONE link, at
                the end. Two links to the same route make the tab order read as
                two destinations and give the entry no single action. */}
            <h3 class="ind-directory__title">{item.title}</h3>

            <div class="ind-directory__detail">
              <p class="ind-directory__desc">{item.description}</p>

              {/* A label rather than a sentence: the list under it is made of
                  bare nouns, and without the label they read as a stray tag
                  cloud rather than as examples of what the category covers. */}
              <p class="ind-directory__label">Example product types</p>

              <ul class="ind-directory__types">
                {item.productTypes.map((type) => (
                  <li class="ind-directory__type">{type}</li>
                ))}
              </ul>

              {item.note && <p class="ind-directory__note">{item.note}</p>}

              <div class="ind-directory__cta">
                <ArrowLink href={item.href} label={item.exploreLabel} brass />
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
