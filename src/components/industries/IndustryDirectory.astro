---
/**
 * IndustryDirectory — the nine-entry category directory  (brief §02)
 * ---------------------------------------------------------------------------
 * The centre of the page, and the reason it exists: it is the navigation
 * mechanism toward the nine `/industries/<slug>` category pages.
 *
 * ── WHY THIS IS NOT THE HOMEPAGE GRID ─────────────────────────────────────
 * The homepage has `IndustryGrid`: nine image tiles, one category each, no
 * copy. Reusing it here would have made this page a second copy of the
 * homepage's `WHAT WE SOURCE` section. The two devices answer two different
 * questions, and they are built the opposite way round:
 *   homepage grid  → nine pictures, so the reader recognises a category
 *   this directory → nine ruled text entries with a description and a link,
 *                    so the reader can tell whether their product is in scope
 *                    before they click
 *
 * ── WHAT AN ENTRY CARRIES NOW (2026-10-02) ────────────────────────────────
 * The brief §02 narrows each entry to three things: the name, one concise
 * description, and a "Learn More" link. The old "Example product types" list
 * and the per-category caveat moved OFF the hub — that depth belongs on the
 * nine category pages, not here. The hub is navigation, the child pages are
 * the detail.
 *
 * ── WHY THE ENTRY ENDS ON ITS LINK ────────────────────────────────────────
 * The "Learn More" action is the LAST thing in each entry, at every width.
 * Putting it under the title would have read well on desktop and badly on
 * mobile — where the stacking order is what the reader actually gets.
 *
 * ── WHY IT IS AN <ol> ─────────────────────────────────────────────────────
 * The nine entries are numbered 01–09 in the data and on screen. That is a
 * sequence with real positions, so it is an ordered list; the number is a
 * `<span class="num">` rather than a list marker because the numbers come from
 * `industries.js` and must not be regenerated by the browser.
 *
 * ── THE SCOPE NOTE ────────────────────────────────────────────────────────
 * `scopeNote` renders under the list as ordinary supporting text, not as a new
 * card or section. It is the page's one honest statement that the nine are the
 * categories SOURDEN sources most often / has supplier networks in — not a
 * boundary — so it must not read like a promotional badge.
 *
 * ── HEADINGS ──────────────────────────────────────────────────────────────
 * Section h2 → one h3 per category. The nine h3s are what put the categories
 * in the document outline, which is the point of a hub page.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';
import ArrowLink from '../ArrowLink.astro';

interface Props {
  eyebrow?: string;
  title: string;
  items: Array<{
    /** From the registry — never re-typed (e.g. `01`). */
    number: string;
    /** From the registry (e.g. `Consumer Products`). */
    title: string;
    /** From the registry — the category page. */
    href: string;
    description: string;
    /** The brief's uniform action label (`Learn More`). */
    ctaLabel: string;
  }>;
  /** Supporting clarification shown under the nine entries. */
  scopeNote?: string;
  tone: 'ivory' | 'white';
  titleId: string;
}

const { eyebrow, title, items, scopeNote, tone, titleId } = Astro.props;
---

<section class={`section section--${tone} ind-directory`} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader
      id={titleId}
      eyebrow={eyebrow}
      title={title}
      class="ind-directory__head"
    />

    <ol class="ind-directory__list">
      {
        items.map((item) => (
          <li class="ind-directory__item">
            <span class="num ind-directory__num">{item.number}</span>

            {/* The heading is not a link: each entry has exactly ONE link, at
                the end. Two links to the same route make the tab order read as
                two destinations and give the entry no single action. */}
            <h3 class="ind-directory__title">{item.title}</h3>

            <div class="ind-directory__detail">
              <p class="ind-directory__desc">{item.description}</p>

              <div class="ind-directory__cta">
                <ArrowLink href={item.href} label={item.ctaLabel} brass />
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    {scopeNote && <p class="ind-directory__scope">{scopeNote}</p>}
  </div>
</section>
