---
/**
 * IndustryScale — the MOQ position, as a short statement  (松霖 §2)
 * ---------------------------------------------------------------------------
 * "NO FIXED MOQ FROM SOURDEN" as a small eyebrow / label, "Source at your
 * scale." as the statement, and one qualifier. Nothing else.
 *
 * ── WHAT THIS USED TO BE ──────────────────────────────────────────────────
 * This component once carried the full "You don't need to start big." essay and
 * the FIRST ORDER → TEST → REPEAT → GROW → SCALE growth path. Both are gone
 * (2026-10-02): the brief removes the growth diagram, and 松霖 asked for a
 * short statement, not a long explanation. The component kept its name so the
 * section keeps its `.ind-scale` ground treatment and the page keeps one
 * device for the MOQ position.
 *
 * ── THE LOAD-BEARING SENTENCE ─────────────────────────────────────────────
 * `qualifier` is not a second paragraph — it is the line without which the
 * statement becomes the claim this site must never make: SOURDEN imposes no
 * fixed MOQ of its own, and that is NOT the same as "every supplier accepts
 * small orders". Setting it in the muted body size under the statement is what
 * stops it reading as small print under a promise while keeping it from
 * ballooning into an explanation.
 *
 * ── NO HEADING ────────────────────────────────────────────────────────────
 * The brief §14 gives this page four H2 headings — What We Source, Not Sure?,
 * Our Approach, Who We Source For. This block is not one of them, so it is
 * labelled with `aria-label` (from the eyebrow) rather than with an `aria-
 * labelledby` heading; the section stays a named region without adding a fifth
 * H2 to the page.
 * ---------------------------------------------------------------------------
 */

interface Props {
  eyebrow?: string;
  /** The one short statement, set prominently. */
  statement: string;
  /** The honest qualifier, set quietly under the statement. */
  qualifier?: string;
  tone: 'ivory' | 'white';
  /** The section's own id (it has no heading to carry one). */
  titleId: string;
}

const { eyebrow, statement, qualifier, tone, titleId } = Astro.props;
---

<section class={`section section--${tone} ind-scale`} aria-label={eyebrow} id={titleId}>
  <div class="container">
    <div class="ind-scale__block">
      <p class="eyebrow ind-scale__eyebrow">{eyebrow}</p>

      <div class="ind-scale__body">
        <p class="ind-scale__statement">{statement}</p>

        {qualifier && <p class="ind-scale__qualifier">{qualifier}</p>}
      </div>
    </div>
  </div>
</section>
