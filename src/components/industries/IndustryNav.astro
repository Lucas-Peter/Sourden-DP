---
/**
 * IndustryNav — the nine categories, with this page marked  (child brief §16)
 * ---------------------------------------------------------------------------
 * "EXPLORE MORE / Other sourcing categories". Every `/industries/<slug>` page
 * ends its editorial half with this band, so a reader who has finished one
 * category can reach the other eight without going back up to the hub.
 *
 * ── WHY ALL NINE, NOT THE OTHER EIGHT ─────────────────────────────────────
 * The brief asks for links to the other eight AND for "the current page
 * visually distinguished from the other categories". Those two requirements
 * cannot both be met by a list that omits the current page — there would be
 * nothing in the list for the reader's own category to be distinguished FROM,
 * and a navigation titled "Other sourcing categories" that silently drops one
 * is how a reader concludes a category does not exist. So all nine are
 * rendered, the eight are links and the ninth is the current page.
 *
 * ── WHY THE CURRENT PAGE IS NOT A LINK ────────────────────────────────────
 * A link back to the page being read looks like a destination and behaves like
 * a dead end. It keeps `aria-current="page"` instead, so assistive technology
 * announces "current page" rather than reading it as one more place to go —
 * the same call `<ServiceChain>` makes for the service a detail page is on, and
 * the same call the header makes for the section the visitor is inside.
 *
 * ── WHY IT IS DELIBERATELY QUIET ──────────────────────────────────────────
 * The brief: "Do not make this visually dominant." This band follows the FAQ by
 * design and sits one section above the page's closing action, so it is built
 * as a ruled index rather than as cards or a second hero: hairline rules, the
 * site's number column, the registry's names. The only two marks that carry
 * colour are the arrow on a destination and the brass label on the current
 * page — nothing here competes with the request band below it.
 *
 * ── IT NAMES NO CATEGORY ──────────────────────────────────────────────────
 * Titles, numbers and hrefs come from `industries.js` via `industryNavFor()`,
 * which also decides which entry is current by comparing the registry's own
 * slug. A page therefore cannot mislabel a neighbour or mark itself current
 * twice, and renaming a category updates this band on all nine pages.
 * ---------------------------------------------------------------------------
 */
import SectionHeader from '../SectionHeader.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  /** All nine, in registry order, with `current` set on this page's own entry. */
  items: Array<{ number: string; title: string; href: string; current: boolean }>;
  tone: 'ivory' | 'white';
  titleId: string;
}

const { eyebrow, title, description, items, tone, titleId } = Astro.props;
---

<section class={`section section--${tone} ind-nav`} aria-labelledby={titleId}>
  <div class="container">
    <SectionHeader id={titleId} eyebrow={eyebrow} title={title} lead={description} class="ind-nav__head" />

    <ul class="ind-nav__list" data-reveal-group>
      {
        items.map((item) => (
          <li class="ind-nav__item">
            {/* The number and the label are two grid tracks, and the arrow is
                inside the label's own flex row rather than a third track —
                otherwise the current entry, which carries no arrow, would have
                a wider label column than the eight around it and the nine
                labels would not line up. */}
            {item.current ? (
              <span class="ind-nav__link ind-nav__link--current" aria-current="page">
                <span class="num ind-nav__num">{item.number}</span>
                <span class="ind-nav__body">
                  <span class="ind-nav__label">{item.title}</span>
                </span>
              </span>
            ) : (
              <a class="ind-nav__link" href={item.href}>
                <span class="num ind-nav__num">{item.number}</span>
                <span class="ind-nav__body">
                  <span class="ind-nav__label">{item.title}</span>
                  <span class="ind-nav__arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
