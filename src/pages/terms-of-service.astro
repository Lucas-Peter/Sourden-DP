---
/**
 * /terms-of-service — the terms that apply when a buyer uses Sourden's services
 * ---------------------------------------------------------------------------
 * Identical in structure to `/privacy-policy` by design — same one-route-two-
 * branches pattern, same page component, same stylesheet, same derived
 * indexability. The two documents differ in their copy and in nothing else, so
 * anything that differs between these two route files other than the data file
 * they import is a mistake. See `privacy-policy.astro` for the full note on the
 * branch, and `src/data/legal-page.js` for the shape to write and the material
 * the copy may be built from.
 *
 * `reservationFor()` is called only in the branch that renders it: on a
 * finished page the reservation entry is not read at all.
 * ---------------------------------------------------------------------------
 */
import LegalPage from '../components/legal/LegalPage.astro';
import ReservationPage from '../components/ReservationPage.astro';

import { page, path } from '../data/legal-terms.js';
import { reservationFor } from '../data/routes.js';
---

{page ? <LegalPage path={path} page={page} /> : <ReservationPage {...reservationFor(path)} />}
