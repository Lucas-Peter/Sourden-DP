---
/**
 * /how-it-works — How China Sourcing Works  (content simplification, 2026-10-02)
 * ---------------------------------------------------------------------------
 * One clear operational explanation: what happens from a sourcing request to a
 * shipment, and who does what. This replaced a sixteen-section deep dive — the
 * owner's simplification brief asked for the same page to feel like a process
 * walkthrough, not a second About or Services page.
 *
 * STRUCTURE (brief)
 *   01 Hero                     eyebrow, H1, copy, two actions, image
 *   02 Six-Step Sourcing Process the rail, now six steps (see data file)
 *   03 Who Does What?           two equal columns — you / Sourden
 *   04 After You Submit         four ordered stages
 *   05 You Don't Have to Use    four reader situations + one onward link
 *      Every Service
 *   06 Final CTA                one primary action
 *
 * REMOVED SECTIONS — and why the removal is total, not just the copy
 *   The old page's per-stage sections (§03–§08: checkList, reviewGrid, the
 *   purchasing stages, the shipping split), its growth path (§12, `HiGrowth`),
 *   its worked example (§13, `HiExample`) and its five-service list (§14) are
 *   gone. `HiGrowth`, `HiStages` and `HiLinkRows` remain — `/about` reuses all
 *   three and imports this same stylesheet — so only `HiExample` (this page's
 *   alone) was deleted with its `.hi-example*` rules. The FAQ (§15) is removed
 *   in full; a single "Have more questions? View FAQ →" text link is all that
 *   remains, per the brief ("at most, a simple text link near the bottom").
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT DO
 *   · It does not promise a response time, a timeline, or guaranteed results.
 *   · It does not present Sourden as a marketplace or automated platform.
 *   · It does not re-tell "Why China" / "Why Sourden" / the MOQ position.
 *
 * IMPORT ORDER IS LOAD-BEARING
 *   Layout first, then the shared sections, then the detail-page sections, then
 *   this page's own sheet — otherwise these rules lose every same-specificity
 *   conflict against the shared core. `npm run audit` fails the build if that
 *   regresses. The devices reused here (hero, rail, split, stage list, rows)
 *   live in `services-shared.css` / `service-detail.css`; this page's own sheet
 *   adds only the `.hi-*` rules for the stage list, the rows and the rail's
 *   label floor.
 *
 * WHY A SECTION DISPATCHER
 *   Order, tones and content live in the data file; nothing about the
 *   composition is buried in markup. Same architecture `/services`, the five
 *   detail pages and `/industries` use.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/services-shared.css';
import '../styles/service-detail.css';
import '../styles/how-it-works.css';

import FinalCTA from '../components/FinalCTA.astro';
import HiLinkRows from '../components/how-it-works/HiLinkRows.astro';
import HiStages from '../components/how-it-works/HiStages.astro';
import ServiceProcess from '../components/services/ServiceProcess.astro';
import ServiceSplit from '../components/services/ServiceSplit.astro';
import BackgroundHero from '../components/BackgroundHero.astro';
import ArrowLink from '../components/ArrowLink.astro';

import {
  breadcrumbs,
  finalCta,
  hero,
  meta,
  sections,
} from '../data/how-it-works-page.js';
import { breadcrumbItems, breadcrumbSchema, webPageSchema } from '../data/schema.js';

const path = '/how-it-works';

/**
 * One graph for the page: the page itself and its breadcrumb. The old page also
 * declared a Service node per §14 row and a FAQ schema for §15; both sections
 * are gone, so their structured data went with them — a claim must never
 * describe a service or question the page does not show.
 */
const schema = [
  webPageSchema({ title: meta.title, description: meta.description, path }),
  breadcrumbSchema(breadcrumbItems(breadcrumbs)),
];

/**
 * Every section needs a unique id for `aria-labelledby`.
 *
 * Derived from the index rather than written by hand, so inserting a section
 * cannot produce a duplicate id. Numbered from `index + 2` because the array
 * starts at the brief's §02 — §01 is the hero, which owns its own id.
 */
const sectionId = (index) => `hi-${String(index + 2).padStart(2, '0')}`;
---

<BaseLayout title={meta.title} description={meta.description} path={path} preloadImageKey={hero.image.key} schema={schema}>
  <BackgroundHero
    breadcrumbs={breadcrumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    description={hero.description}
    primaryCta={hero.primaryCta}
    secondaryCta={hero.secondaryCta}
    imageKey={hero.image.key}
    titleId="hi-01"
  />

  {
    sections.map((section, index) => {
      const titleId = sectionId(index);

      switch (section.type) {
        case 'process':
          /* §02. The rail owns the ink band. `hi-process` is the one hook this
             page adds to it — a two-line floor for the phrase-length labels. */
          return (
            <ServiceProcess
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              steps={section.steps}
              class="hi-process"
              titleId={titleId}
            />
          );

        case 'split':
          /* §03. Two equal columns — the customer's decisions beside Sourden's
             coordination. */
          return (
            <ServiceSplit
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              columns={section.columns}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'stages':
          /* §04. The numbered post-request sequence. */
          return (
            <HiStages
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              items={section.items}
              numbered={section.numbered}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'linkRows':
          /* §05. Four reader situations, none of which is itself a link — the
             onward action is the section's closing "View All Services". */
          return (
            <HiLinkRows
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              items={section.items}
              numbered={section.numbered}
              foot={section.foot}
              tone={section.tone}
              titleId={titleId}
            />
          );

        default:
          throw new Error(
            `[/how-it-works] Unknown section type "${section.type}" at index ${index}. ` +
              `See the section vocabulary in src/data/how-it-works-page.js.`
          );
      }
    })
  }

  {/* The brief's §09: no full FAQ, just one text link near the bottom. It is a
      <div>, not a <section>, so the page keeps its six-section structure. */}
  <div class="container hi-faq-link">
    <ArrowLink href="/faq" label="Have more questions? View FAQ" brass />
  </div>

  <FinalCTA
    eyebrow={finalCta.eyebrow}
    title={finalCta.title}
    description={finalCta.description}
    cta={finalCta.cta}
  />
</BaseLayout>
