---
/**
 * /insights — the SOURDEN content library
 * ---------------------------------------------------------------------------
 * This route used to render a reservation page. It is now the hub: a compact
 * hero, the directory of the twelve planned articles, the five service links,
 * and the closing band.
 *
 * STRUCTURE
 *   01 Hero                     §2   eyebrow, H1, supporting text, two actions
 *   02 Article directory        §5   the grid, its count line and its paging
 *   03 Connection to services   §10  the five services, from the registry
 *   04 Final CTA                §11  closing band, one action
 *
 * IT CARRIED SEVEN BANDS AND NOW CARRIES FOUR
 *   The presentation was simplified to the shape this directory was designed
 *   for. §3's featured band, §4's category chips, §8 and §9 are gone; §10 is
 *   kept because §15 asks the page to link to all five service detail pages and
 *   it is where those links live. `src/data/insights-page.js` holds the full
 *   list, with what each removal means and where the brief's copy for it still
 *   is. The hero has carried a photograph since 2026-10-02 — as a full-bleed
 *   background with the copy overlaid. That shape was this page's own
 *   component until the homepage adopted it the same day, at which point it
 *   was promoted to the shared `BackgroundHero.astro`; see the slot's history
 *   note in `media.js`.
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT DO
 *   · It does not build a single article. §13 is explicit: the purpose of this
 *     task is the hub, and the twelve `/insights/<slug>` routes stay reserved —
 *     they resolve, they render the reservation shell, and they carry `noindex`
 *     until their copy exists. Every link to them is live today, so writing an
 *     article later rewrites no link.
 *   · It does not create category pages. §9: "Do not create unnecessary
 *     separate category pages at this stage." The categories are printed on the
 *     cards as tags.
 *   · It does not invent metadata. No dates, authors, reading times, view
 *     counts, "Coming soon" or empty-state messages — §6, §13 and §14 forbid
 *     every one of them by name.
 *   · It does not redesign anything. The hero, the ruled-row list, the buttons,
 *     the arrow links, the reveal device and the closing band are all the
 *     existing site's; only the composition and the card are new, and the card
 *     borrows the homepage's card language without its stylesheet.
 *   · It does not touch the header or the footer (§19.12).
 *
 * INDEXABILITY
 *   This page is real, so it is indexable and appears in sitemap.xml. Its entry
 *   in `reservedTopLevel` (src/data/routes.js) was deleted when it was
 *   published — that list is what drives the noindex/sitemap split, so
 *   forgetting it would have left a finished, content-rich page excluded from
 *   search. The twelve article routes stay in `detailRoutePaths` and remain
 *   noindex.
 *
 * IMPORT ORDER IS LOAD-BEARING
 *   Layout first, then the shared sheets, then this page's own — otherwise the
 *   page rules lose every same-specificity conflict against the shared core and
 *   `npm run audit` fails the build. `how-it-works.css` is here for the ruled
 *   rows (`.hi-rows*`) §10 renders; its file name says "how-it-works" because
 *   that page was the device's first consumer, exactly as `/industries` and
 *   `/about` already document for the same sheet.
 *
 * WHY A SECTION DISPATCHER
 *   A dispatcher keeps the order, the tones and the content in
 *   `insights-page.js` and nothing about the composition in markup — the
 *   architecture `/industries` and the five service detail pages use — so a
 *   band can be reordered or inserted without touching a template. An unknown
 *   `type` throws rather than rendering nothing, because a typo in a data file
 *   must not quietly delete a section from the page.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/services-shared.css';
import '../../styles/how-it-works.css';
import '../../styles/insights.css';

import FinalCTA from '../../components/FinalCTA.astro';
import BackgroundHero from '../../components/BackgroundHero.astro';
import HiLinkRows from '../../components/how-it-works/HiLinkRows.astro';
import InsightsDirectory from '../../components/insights/InsightsDirectory.astro';

import { breadcrumbs, finalCta, hero, meta, sections } from '../../data/insights-page.js';
import { breadcrumbItems, breadcrumbSchema, webPageSchema } from '../../data/schema.js';

const path = '/insights';

/**
 * One graph for the page: the page itself and its breadcrumb.
 *
 * No `ItemList` of the twelve articles, deliberately. Structured data exists to
 * describe pages a search engine can usefully visit, and every one of those
 * twelve routes is a `noindex` reservation shell today — declaring them as a
 * list of articles would be asserting content that does not exist, which is the
 * same fabrication the brief forbids in prose.
 */
const schema = [
  webPageSchema({ title: meta.title, description: meta.description, path }),
  breadcrumbSchema(breadcrumbItems(breadcrumbs)),
];
---

<BaseLayout title={meta.title} description={meta.description} path={path} preloadImageKey="insightsHero" schema={schema}>
  {/* A full-bleed hero: the photograph behind the copy, the copy overlaid.
      A named 2026-10-02 override of §2's "Do not make the hero overly large"
      — same four elements plus the §11 secondary, one band tall, never a
      banner. The device is the shared BackgroundHero (promoted here when the
      homepage took the same shape). */}
  <BackgroundHero
    breadcrumbs={breadcrumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    description={hero.description}
    primaryCta={hero.primaryCta}
    secondaryCta={hero.secondaryCta}
    imageKey="insightsHero"
    titleId="in-hero-title"
  />

  {
    sections.map((section) => {
      switch (section.type) {
        case 'directory':
          return (
            <InsightsDirectory
              directory={section.directory}
              tone={section.tone}
              titleId={section.titleId}
            />
          );

        case 'linkRows':
          /* §10: the five services in registry order, numbered. `numbered` is
             the list-level flag that reserves the number column — the same
             split `IndustryRows` and `HiLinkRows` document in their headers. */
          return (
            <HiLinkRows
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              items={section.items}
              numbered={section.numbered}
              tone={section.tone}
              titleId={section.titleId}
            />
          );

        default:
          throw new Error(
            `[/insights] Unknown section type "${section.type}". ` +
              `See the section vocabulary in src/data/insights-page.js.`
          );
      }
    })
  }

  <FinalCTA
    eyebrow={finalCta.eyebrow}
    title={finalCta.title}
    description={finalCta.description}
    cta={finalCta.cta}
  />
</BaseLayout>
