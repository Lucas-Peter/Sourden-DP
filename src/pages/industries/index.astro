---
/**
 * /industries — Industries & Product Categories  (Industries brief §01–§16)
 * ---------------------------------------------------------------------------
 * This route is the site's product-category hub: it answers "what can SOURDEN
 * source from China?" with a nine-entry directory and routes the visitor to the
 * nine `/industries/<slug>` pages, which carry the deeper per-category content.
 *
 * STRUCTURE (2026-10-02, content-simplification pass)
 *   01 Hero                        eyebrow, H1, one-line copy, two actions
 *   02 Category directory          nine entries + the scope note
 *   03 Not sure where it fits?     the "tell us anyway" exit
 *   04 Our approach                short prose + "How It Works →"
 *   05 Who we source for           the five buyer types
 *   06 No fixed MOQ                one statement + one qualifier
 *   —  "Have questions? View FAQ"  one centred text link, not a section
 *   +   Final CTA                  one primary action
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT DO
 *   · It does not reproduce the nine category pages. Each directory entry is
 *     name + one concise description + "Learn More"; the product-type lists,
 *     per-category caveats and process detail live on the child pages.
 *   · It does not duplicate the five-step rail (→ /how-it-works), the five
 *     service descriptions (→ /services), the FAQ (→ /faq), the five strategies
 *     or the growth path. Those were removed in this pass — the hub is
 *     navigation, not a second About / Services / How-It-Works page.
 *   · It adds no claim the business cannot evidence (see the claims rule in
 *     `src/data/industries-page.js`).
 *
 * INDEXABILITY
 *   This page is real, so it is indexable and appears in sitemap.xml.
 *
 * IMPORT ORDER IS LOAD-BEARING
 *   Layout first, then the shared sections, then this page's own sheet —
 *   otherwise these rules lose every same-specificity conflict against the
 *   shared core. `npm run audit` fails the build if that regresses.
 *
 *   This page imports `service-detail.css` for the prose device (`.sec-prose*`)
 *   rather than carrying its own copy. It no longer imports `services-shared.css`:
 *   the rail and the FAQ — that sheet's only consumers here — were removed in
 *   this pass, and the hero is the background `<BackgroundHero>` (core
 *   `components.css`), not the old `.sec-hero`. See `src/styles/index.css`.
 *
 * WHY A SECTION DISPATCHER
 *   A dispatcher means the page's order, tones and content live in the data
 *   file and nothing about the composition is buried in markup — the same
 *   architecture the five service-detail pages use, so a section can be
 *   reordered or inserted without touching a template.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/service-detail.css';
import '../../styles/industries.css';

import FinalCTA from '../../components/FinalCTA.astro';
import IndustryDirectory from '../../components/industries/IndustryDirectory.astro';
import IndustryRows from '../../components/industries/IndustryRows.astro';
import IndustryScale from '../../components/industries/IndustryScale.astro';
import ServiceProse from '../../components/services/ServiceProse.astro';
import BackgroundHero from '../../components/BackgroundHero.astro';
import ArrowLink from '../../components/ArrowLink.astro';

import {
  breadcrumbs,
  finalCta,
  hero,
  meta,
  sections,
} from '../../data/industries-page.js';
import { breadcrumbItems, breadcrumbSchema, webPageSchema } from '../../data/schema.js';

const path = '/industries';

/**
 * One graph for the page: the page itself and its breadcrumb. There are no
 * Service or FAQPage nodes — the related-services band and the FAQ were removed
 * in this pass, so the structured data must not describe content the page does
 * not show (a Service node for a service the page no longer lists would be a
 * structured-data claim about a different page).
 */
const schema = [
  webPageSchema({ title: meta.title, description: meta.description, path }),
  breadcrumbSchema(breadcrumbItems(breadcrumbs)),
];

/**
 * Every section needs a unique id for `aria-labelledby`.
 *
 * Derived from the index rather than written by hand, so inserting a section
 * cannot produce a duplicate id. Numbered from `index + 2` because the array
 * starts at the brief's §02 — §01 is the hero, which owns its own id.
 */
const sectionId = (index) => `ind-${String(index + 2).padStart(2, '0')}`;
---

<BaseLayout title={meta.title} description={meta.description} path={path} preloadImageKey={hero.image.key} schema={schema}>
  <BackgroundHero
    breadcrumbs={breadcrumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    description={hero.description}
    primaryCta={hero.primaryCta}
    secondaryCta={hero.secondaryCta}
    imageKey={hero.image.key}
    titleId="ind-01"
  />

  {
    sections.map((section, index) => {
      const titleId = sectionId(index);

      switch (section.type) {
        case 'prose':
          return (
            <ServiceProse
              eyebrow={section.eyebrow}
              title={section.title}
              paragraphs={section.paragraphs}
              emphasis={section.emphasis}
              tone={section.tone}
              foot={section.foot}
              links={section.links}
              titleId={titleId}
            />
          );

        case 'directory':
          /* The page's centrepiece. Its nine entries are merged from
             `industries.js` in the data file — nothing about a category name,
             number or route is typed into this template. */
          return (
            <IndustryDirectory
              eyebrow={section.eyebrow}
              title={section.title}
              items={section.items}
              scopeNote={section.scopeNote}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'people':
          return (
            <IndustryRows
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              items={section.items}
              foot={section.foot}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'scale':
          return (
            <IndustryScale
              eyebrow={section.eyebrow}
              statement={section.statement}
              qualifier={section.qualifier}
              tone={section.tone}
              titleId={titleId}
            />
          );

        default:
          /* A typo in a `type` string must not render nothing and pass the
             build — the section would simply vanish from the page. */
          throw new Error(
            `[/industries] Unknown section type "${section.type}" at index ${index}. ` +
              `See the section vocabulary in src/data/industries-page.js.`
          );
      }
    })
  }

  {/* Brief §09: the full FAQ lives at /faq; one centred text link is enough.
      A <div>, not a <section>, so the page keeps its six-section structure. */}
  <div class="container ind-faq-link">
    <ArrowLink href="/faq" label="Have questions? View FAQ" brass />
  </div>

  <FinalCTA
    eyebrow={finalCta.eyebrow}
    title={finalCta.title}
    description={finalCta.description}
    cta={finalCta.cta}
  />
</BaseLayout>
