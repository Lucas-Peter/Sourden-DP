---
/**
 * SOURDEN — Homepage
 * ---------------------------------------------------------------------------
 * Section order follows spec §42, with one deliberate exception: the "What We
 * Do" section (spec §9, eyebrow "SOURCING, SIMPLIFIED") has been REMOVED.
 *
 * WHY: its numbered list (Supplier Research / Quotation / Purchasing / Quality
 * Control / Shipping) restated the Services section almost item for item, and
 * the dark capabilities strip directly above it already carries a third copy
 * of the same five nouns. Three overlapping lists in the top half of one page
 * read as padding. The Services section keeps the real, differentiated copy
 * (one description per service) and the capabilities strip keeps the overview.
 * Do not reintroduce it.
 *
 *   01 Header
 *   02 Hero
 *   03 Capabilities
 *   04 Services
 *   05 How It Works
 *   06 Industries
 *   07 Sourcing Without the Barriers  (§13 + §14 + §15)
 *   08 Why Sourden
 *   09 Case Studies
 *   10 Insights
 *   11 Final CTA
 *   12 Footer
 *
 * Colour rhythm ivory → dark → white → ivory → white → ivory → dark → white →
 * ivory → dark is carried by each component's own class, not by this file.
 * ---------------------------------------------------------------------------
 */

// Page-level styles only. The shared core (tokens/base/layout/components) is
// imported once by BaseLayout, so `/services` and every future page never ship
// the homepage's CSS.
import BaseLayout from '../layouts/BaseLayout.astro';

/* Import order is load-bearing.
   Astro evaluates rules of equal specificity in import order, so the LAYOUT
   must be imported first: that gives the shared core the LOWEST precedence,
   which is what allows this page's stylesheet to override component
   defaults. Swap these two lines and the overrides silently stop applying.
   https://docs.astro.build/en/guides/styling/  ("Import Order") */
import '../styles/home.css';
import Hero from '../components/Hero.astro';
import CapabilitiesStrip from '../components/CapabilitiesStrip.astro';
import ServiceList from '../components/ServiceList.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import IndustryGrid from '../components/IndustryGrid.astro';
import AudienceList from '../components/AudienceList.astro';
import WhySourdenList from '../components/WhySourdenList.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Insights from '../components/Insights.astro';
import FinalCTA from '../components/FinalCTA.astro';

import { homeMeta } from '../data/home.js';
import { webPageSchema } from '../data/schema.js';
---

<BaseLayout
  title={homeMeta.title}
  description={homeMeta.description}
  path="/"
  schema={[
    webPageSchema({
      title: homeMeta.title,
      description: homeMeta.description,
      path: '/',
    }),
  ]}
>
  <Hero />
  <CapabilitiesStrip />
  <ServiceList />
  <ProcessTimeline />
  <IndustryGrid />
  <AudienceList />
  <WhySourdenList />
  <CaseStudies />
  <Insights />
  <FinalCTA />
</BaseLayout>
