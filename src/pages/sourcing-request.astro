---
/**
 * /sourcing-request — the primary conversion destination (spec §5, §6, §34)
 * ---------------------------------------------------------------------------
 * This route used to render a reservation page. It is now the real thing: the
 * sourcing brief every "Start a Sourcing Request" CTA on the site points at.
 *
 * STRUCTURE (spec §6 — the form is the focus, so nothing is allowed to push it
 * down the page)
 *   Hero          — eyebrow, H1, supporting copy, one documentary image
 *   Brief         — seven numbered blocks + submission area + success/error
 *   What happens  — four steps, after the form rather than before it
 *   Statement     — one closing editorial line on ink
 *   Outro         — two navigation links. Not a second marketing block (§27).
 *
 * WHERE THE COPY LIVES
 *   `src/data/sourcing-request.js` — every word, label and option set.
 *   `src/lib/inquiry.ts`           — the types, validation and submit/upload
 *                                    calls, deliberately free of DOM access so
 *                                    the same rules can run server-side (§36).
 *
 * IMPORT ORDER IS LOAD-BEARING
 *   The layout (and therefore the shared core stylesheet) must be imported
 *   before the page stylesheet, or page rules silently lose same-specificity
 *   conflicts. `npm run audit` fails the build if this regresses.
 *
 * NOT INDEXED BY DEFAULT? — no. This page is real, so it is indexable and it
 *   appears in sitemap.xml. Its entry in `reservedTopLevel`
 *   (src/data/routes.js) was removed in the same change; that list is what
 *   drives the noindex/sitemap split.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/sourcing-request.css';

import ArrowLink from '../components/ArrowLink.astro';
import SourcingRequestForm from '../components/SourcingRequestForm.astro';
import SourcingRequestHero from '../components/SourcingRequestHero.astro';
import SupportingStatement from '../components/SupportingStatement.astro';
import WhatHappensNext from '../components/WhatHappensNext.astro';

import { breadcrumbs, finalNav, sourcingRequestMeta } from '../data/sourcing-request.js';
import { breadcrumbItems, breadcrumbSchema, webPageSchema } from '../data/schema.js';

const path = '/sourcing-request';

/* The breadcrumb schema is built from the SAME array the visible trail is given,
   so the two cannot disagree — they previously did, in opposite directions: the
   trail duplicated "Home" and the schema omitted it. See `breadcrumbItems()`. */
const schema = [
  webPageSchema({
    title: sourcingRequestMeta.title,
    description: sourcingRequestMeta.description,
    path,
  }),
  breadcrumbSchema(breadcrumbItems(breadcrumbs)),
];
---

<BaseLayout
  title={sourcingRequestMeta.title}
  description={sourcingRequestMeta.description}
  path={path}
  schema={schema}
  hideStickyCta
>
  <SourcingRequestHero />

  <SourcingRequestForm />

  <WhatHappensNext />

  <SupportingStatement />

  {/* Spec §27 — navigation only. The page has already asked for the request;
      a second hard sell underneath it would undercut the one above. */}
  <nav class="section section--dark sr-outro" aria-label="Continue exploring Sourden">
    <div class="container sr-outro__inner">
      <ArrowLink href={finalNav.services.href} label={finalNav.services.label} />
      <ArrowLink href={finalNav.howItWorks.href} label={finalNav.howItWorks.label} />
    </div>
  </nav>
</BaseLayout>
