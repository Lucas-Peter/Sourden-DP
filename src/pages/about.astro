---
/**
 * /about — About SOURDEN  (content simplification, 2026-10-02)
 * ---------------------------------------------------------------------------
 * This route is the company About page: why Sourden exists, the gap it fills,
 * how it works, who it works with, how fees are handled, and how to get in
 * touch. The owner's simplification brief asked for a concise, credible page —
 * not a second Services, FAQ or How-It-Works page — and this replaced an
 * eighteen-section brand-positioning deep dive.
 *
 * STRUCTURE (brief §13)
 *   01 Hero                    eyebrow, H1, copy, tagline, two actions, image
 *   02 Why Sourden             prose
 *   03 The Gap We Solve        prose
 *   04 Our Approach            a six-word → chain
 *   05 What We Actually Do     a five-node ↓ chain (ink band)
 *   06 Who We Work With        five audience groups
 *   07 How Our Fees Work       prose + fee statement + link
 *   08 Get In Touch            email + WhatsApp
 *   —  "View FAQ" text link    one centred link, not a section
 *   09 Final CTA               one primary action
 *
 * REMOVED SECTIONS — and why the removal is total, not just the copy
 *   The old page's statement sections (§04, §13), its growth progression (§05,
 *   `HiGrowth`), its scale stages (§06), its four-limit list (§09), its process
 *   stages (§10, `HiStages`), its standard (§11), its landscape prose (§12), its
 *   relationship chain (§14), its five-service list (§15, `HiLinkRows`), its
 *   business prose (§16) and its full FAQ (§17) are gone. `HiGrowth`,
 *   `HiStages` and `HiLinkRows` remain — `/how-it-works` uses them and imports
 *   the same stylesheet — so only `AboutStatement` (this page's alone) was
 *   deleted with its `.ab-statement*` rules.
 *
 * WHAT THIS PAGE DELIBERATELY DOES NOT DO
 *   · It does not publish fixed commission percentages or fixed/minimum fees.
 *   · It does not invent a founding year, founder, team size, offices,
 *     supplier or customer numbers, countries served, order volume, revenue,
 *     certifications, awards, testimonials or success rates.
 *   · It does not claim to eliminate sourcing risk or always find the lowest
 *     price.
 *   · It does not display a Facebook link (no official page yet).
 *
 * IMPORT ORDER IS LOAD-BEARING
 *   Layout first, then the shared sections, then this page's own sheet —
 *   otherwise these rules lose every same-specificity conflict against the
 *   shared core. `npm run audit` fails the build if that regresses. The devices
 *   reused here (prose, review grid) live in `service-detail.css`; this page's
 *   own sheet adds the chain and the contact block.
 *
 * WHY A SECTION DISPATCHER
 *   Order, tones and content live in the data file; nothing about the
 *   composition is buried in markup. Same architecture `/services`, the five
 *   detail pages, `/industries` and `/how-it-works` use. An unknown `type`
 *   throws at build time rather than silently dropping a section.
 * ---------------------------------------------------------------------------
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/service-detail.css';
import '../styles/about.css';

import AboutContact from '../components/about/AboutContact.astro';
import AboutFlow from '../components/about/AboutFlow.astro';
import ServiceProse from '../components/services/ServiceProse.astro';
import ServiceReviewGrid from '../components/services/ServiceReviewGrid.astro';
import FinalCTA from '../components/FinalCTA.astro';
import BackgroundHero from '../components/BackgroundHero.astro';
import ArrowLink from '../components/ArrowLink.astro';

import { breadcrumbs, finalCta, hero, meta, sections } from '../data/about-page.js';
import { breadcrumbItems, breadcrumbSchema, webPageSchema } from '../data/schema.js';

const path = '/about';

/**
 * One graph for the page: the page itself and its breadcrumb. The old page also
 * declared a Service node per §15 row and a FAQPage node for §17; both sections
 * are gone, so their structured data went with them — a claim must never
 * describe a service or question the page does not show.
 */
const schema = [
  webPageSchema({ title: meta.title, description: meta.description, path }),
  breadcrumbSchema(breadcrumbItems(breadcrumbs)),
];

/**
 * Every section needs a unique id for `aria-labelledby`.
 *
 * Derived from the index rather than written by hand, so inserting a section
 * cannot produce a duplicate id. Numbered from `index + 2` because the array
 * starts at the brief's §02 — §01 is the hero, which owns its own id.
 */
const sectionId = (index) => `ab-${String(index + 2).padStart(2, '0')}`;
---

<BaseLayout title={meta.title} description={meta.description} path={path} preloadImageKey={hero.image.key} schema={schema}>
  <BackgroundHero
    breadcrumbs={breadcrumbs}
    eyebrow={hero.eyebrow}
    title={hero.title}
    description={hero.description}
    tagline={hero.tagline}
    primaryCta={hero.primaryCta}
    secondaryCta={hero.secondaryCta}
    imageKey={hero.image.key}
    titleId="ab-01"
  />

  {
    sections.map((section, index) => {
      const titleId = sectionId(index);

      switch (section.type) {
        case 'prose':
          /* §02, §03, §07. The shared editorial prose device: heading on the
             left, paragraphs on the right, an optional brass closing line and
             an optional closing link. */
          return (
            <ServiceProse
              eyebrow={section.eyebrow}
              title={section.title}
              paragraphs={section.paragraphs}
              emphasis={section.emphasis}
              foot={section.foot}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'flow':
          /* §04 (horizontal →) and §05 (vertical ↓). Same device, two
             directions — see the component for why the direction is the brief's
             decision rather than a layout preference. */
          return (
            <AboutFlow
              eyebrow={section.eyebrow}
              title={section.title}
              paragraphs={section.paragraphs}
              orientation={section.orientation}
              marker={section.marker}
              nodes={section.nodes}
              foot={section.foot}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'reviewGrid':
          /* §06. N titled items with a sentence each, as a two-column
             editorial list. */
          return (
            <ServiceReviewGrid
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              items={section.items}
              tone={section.tone}
              titleId={titleId}
            />
          );

        case 'contact':
          /* §08. The email + WhatsApp block. The values come from `site.js`,
             not from the page data — see the component. */
          return (
            <AboutContact
              eyebrow={section.eyebrow}
              title={section.title}
              description={section.description}
              tone={section.tone}
              titleId={titleId}
            />
          );

        default:
          throw new Error(
            `[/about] Unknown section type "${section.type}" at index ${index}. ` +
              `See the section vocabulary in src/data/about-page.js.`
          );
      }
    })
  }

  {/* The brief's §11: no full FAQ, just one text link near the bottom. It is a
      <div>, not a <section>, so the page keeps its eight-section structure. */}
  <div class="container ab-faq-link">
    <ArrowLink href="/faq" label="Have more questions? View FAQ" brass />
  </div>

  <FinalCTA
    eyebrow={finalCta.eyebrow}
    title={finalCta.title}
    description={finalCta.description}
    cta={finalCta.cta}
  />
</BaseLayout>
