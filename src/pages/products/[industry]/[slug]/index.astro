---
/**
 * DETAIL ROUTE — /products/[industry]/[slug] (page 1 of the catalogue)
 * ---------------------------------------------------------------------------
 * Page 1 of a product collection. A collection with 24 or fewer reference
 * styles is the only page; longer catalogues continue on
 * `/products/[industry]/[slug]/page/N`, generated by the sibling
 * `[page].astro` route.
 *
 * The `[industry]` segment is the collection's parent 大类 (a slug in
 * `industries.js`) and is part of the URL — a collection URL reads
 * `/products/apparel-footwear-bags/soccer-jerseys`. It is read from the
 * collection's `industrySlug` field in `getStaticPaths`, so the URL can never
 * disagree with the breadcrumb.
 *
 * The route is generated from the collection registry, so adding a collection
 * creates its page-1 route automatically — no new page file. There is no
 * reservation branch: a slug with no data file generates no route at all, and
 * a link to it is a 404 the audit's internal-link check catches.
 *
 * Both this file and `[page].astro` render the same `CollectionPage` shell;
 * they differ only in which slice of the registry each `getStaticPaths`
 * produces.
 * ---------------------------------------------------------------------------
 */
import CollectionPage from '../../../../components/collections/CollectionPage.astro';
import { collections, paginateProducts } from '../../../../data/product-collections.js';

export function getStaticPaths() {
  return collections.map((collection) => ({
    params: { industry: collection.industrySlug, slug: collection.slug },
    props: {
      collection,
      page: 1,
      pagination: paginateProducts(collection.products, 1),
    },
  }));
}

const { collection, pagination } = Astro.props;
---

<CollectionPage collection={collection} page={1} pagination={pagination} />
